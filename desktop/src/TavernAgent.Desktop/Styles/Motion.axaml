<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Motion library (v3). Reusable enter/feedback animations + transitions.
    Durations follow DesignTokens (micro 80 / quick 150 / fast 250 / medium 350 / slow 450)
    and easings follow the two house curves: smooth-out 0.23,1,0.32,1 for most motion,
    spring 0.16,1,0.3,1 for entrances. Overshoot is reserved for badge pops only.
    Transform animations use the animatable transform property paths
    (TranslateTransform.X/Y, ScaleTransform.ScaleX/Y, RotateTransform.Angle).
    Reduced-motion: MotionPreference swaps this file for ReducedMotion.axaml.
  -->

  <!-- Enter: fade + rise 8px (transitions.dev distance "Base") -->
  <Style Selector=":is(Control).anim-rise">
    <Style.Animations>
      <Animation Duration="0:0:0.25" Easing="0.23,1,0.32,1" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="8" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Enter: fade + pop (modal / palette: scale .96 -> 1, spring) -->
  <Style Selector=":is(Control).anim-pop">
    <Style.Animations>
      <Animation Duration="0:0:0.25" Easing="0.16,1,0.3,1" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="ScaleTransform.ScaleX" Value="0.96" />
          <Setter Property="ScaleTransform.ScaleY" Value="0.96" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Enter: fade only -->
  <Style Selector=":is(Control).anim-fade">
    <Style.Animations>
      <Animation Duration="0:0:0.15" Easing="0.23,1,0.32,1" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Enter: slide in from the right (panel reveal 350ms) -->
  <Style Selector=":is(Control).anim-slide-in-right">
    <Style.Animations>
      <Animation Duration="0:0:0.35" Easing="0.23,1,0.32,1" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.X" Value="16" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.X" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Enter: slide in from the left -->
  <Style Selector=":is(Control).anim-slide-in-left">
    <Style.Animations>
      <Animation Duration="0:0:0.35" Easing="0.23,1,0.32,1" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.X" Value="-16" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.X" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Enter: rise from below (toast / composer, 350ms spring) -->
  <Style Selector=":is(Control).anim-rise-in-bottom">
    <Style.Animations>
      <Animation Duration="0:0:0.35" Easing="0.16,1,0.3,1" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="12" />
          <Setter Property="ScaleTransform.ScaleX" Value="0.98" />
          <Setter Property="ScaleTransform.ScaleY" Value="0.98" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Infinite: soft pulse (skeleton / thinking) -->
  <Style Selector=":is(Control).anim-pulse">
    <Style.Animations>
      <Animation Duration="0:0:1.8" IterationCount="INFINITE" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Infinite: spin -->
  <Style Selector=":is(Control).anim-spin">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="INFINITE" Easing="LinearEasing">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Stagger delays for list reveals: 40ms per item, total under 300ms -->
  <Style Selector=":is(Control).stagger-1">
    <Style.Animations>
      <Animation Duration="0:0:0.25" Delay="0:0:0.04" Easing="0.23,1,0.32,1" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="8" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector=":is(Control).stagger-2">
    <Style.Animations>
      <Animation Duration="0:0:0.25" Delay="0:0:0.08" Easing="0.23,1,0.32,1" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="8" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector=":is(Control).stagger-3">
    <Style.Animations>
      <Animation Duration="0:0:0.25" Delay="0:0:0.12" Easing="0.23,1,0.32,1" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="8" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector=":is(Control).stagger-4">
    <Style.Animations>
      <Animation Duration="0:0:0.25" Delay="0:0:0.16" Easing="0.23,1,0.32,1" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="8" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector=":is(Control).stagger-5">
    <Style.Animations>
      <Animation Duration="0:0:0.25" Delay="0:0:0.2" Easing="0.23,1,0.32,1" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="8" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector=":is(Control).stagger-6">
    <Style.Animations>
      <Animation Duration="0:0:0.25" Delay="0:0:0.24" Easing="0.23,1,0.32,1" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="8" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Hover lift (cards): 1px, quick -->
  <Style Selector=":is(Control).hover-lift">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="0.23,1,0.32,1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(Border).hover-lift">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="0.23,1,0.32,1" />
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(Control).hover-lift:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-1px)" />
  </Style>

  <!-- Press feedback: 80ms micro -->
  <Style Selector=":is(Control).press">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" Easing="0.23,1,0.32,1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(Control).press:pressed">
    <Setter Property="RenderTransform" Value="scale(0.98)" />
  </Style>

  <!-- Glide: smooth transform movement (segmented indicator / morph), symmetric 250ms -->
  <Style Selector=":is(Control).glide">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="0.23,1,0.32,1" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Soft brush cross-fade: 150ms quick -->
  <Style Selector=":is(TemplatedControl).soft-brush">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(Border).soft-brush">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
</Styles>
