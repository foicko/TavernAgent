<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Motion library (v2). Reusable enter/exit/feedback animations + transitions.
    Transform animations use the animatable transform property paths
    (TranslateTransform.X/Y, ScaleTransform.ScaleX/Y, RotateTransform.Angle).
    Reduced-motion is handled globally in App.axaml.
  -->

  <!-- Enter: fade + rise -->
  <Style Selector=":is(Control).anim-rise">
    <Style.Animations>
      <Animation Duration="0:0:0.42" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="10" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Enter: fade + pop (spring-ish overshoot) -->
  <Style Selector=":is(Control).anim-pop">
    <Style.Animations>
      <Animation Duration="0:0:0.38" Easing="BackEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="ScaleTransform.ScaleX" Value="0.94" />
          <Setter Property="ScaleTransform.ScaleY" Value="0.94" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Enter: fade only -->
  <Style Selector=":is(Control).anim-fade">
    <Style.Animations>
      <Animation Duration="0:0:0.3" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Enter: slide in from the right (flyout / sheet) -->
  <Style Selector=":is(Control).anim-slide-in-right">
    <Style.Animations>
      <Animation Duration="0:0:0.34" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.X" Value="24" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.X" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Enter: slide in from the left -->
  <Style Selector=":is(Control).anim-slide-in-left">
    <Style.Animations>
      <Animation Duration="0:0:0.34" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.X" Value="-24" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.X" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Enter: rise from below (toast / composer) -->
  <Style Selector=":is(Control).anim-rise-in-bottom">
    <Style.Animations>
      <Animation Duration="0:0:0.4" Easing="BackEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="18" />
          <Setter Property="ScaleTransform.ScaleX" Value="0.98" />
          <Setter Property="ScaleTransform.ScaleY" Value="0.98" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Infinite: soft pulse -->
  <Style Selector=":is(Control).anim-pulse">
    <Style.Animations>
      <Animation Duration="0:0:1.8" IterationCount="INFINITE" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.45" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.45" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Infinite: spin -->
  <Style Selector=":is(Control).anim-spin">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="INFINITE" Easing="LinearEasing">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Stagger delays for list reveals -->
  <Style Selector=":is(Control).stagger-1">
    <Style.Animations>
      <Animation Duration="0:0:0.5" Delay="0:0:0.02" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="10" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector=":is(Control).stagger-2">
    <Style.Animations>
      <Animation Duration="0:0:0.5" Delay="0:0:0.06" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="10" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector=":is(Control).stagger-3">
    <Style.Animations>
      <Animation Duration="0:0:0.5" Delay="0:0:0.1" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="10" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector=":is(Control).stagger-4">
    <Style.Animations>
      <Animation Duration="0:0:0.5" Delay="0:0:0.14" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="10" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector=":is(Control).stagger-5">
    <Style.Animations>
      <Animation Duration="0:0:0.5" Delay="0:0:0.18" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="10" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector=":is(Control).stagger-6">
    <Style.Animations>
      <Animation Duration="0:0:0.5" Delay="0:0:0.22" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="10" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Hover lift (buttons / cards) -->
  <Style Selector=":is(Control).hover-lift">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(Border).hover-lift">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(Control).hover-lift:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-2px)" />
  </Style>

  <!-- Press feedback -->
  <Style Selector=":is(Control).press">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(Control).press:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>

  <!-- Glide: smooth transform movement (indicator / morph) -->
  <Style Selector=":is(Control).glide">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.34" Easing="BackEaseOut" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.24" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Soft brush cross-fade -->
  <Style Selector=":is(TemplatedControl).soft-brush">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.24" />
        <BrushTransition Property="Foreground" Duration="0:0:0.24" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.24" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(Border).soft-brush">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.24" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.24" />
      </Transitions>
    </Setter>
  </Style>
</Styles>
