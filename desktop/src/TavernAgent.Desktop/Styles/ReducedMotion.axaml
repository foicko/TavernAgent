<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Reduced-motion overrides. Added at runtime by MotionPreference when the OS
    (or TAVERNAGENT_REDUCE_MOTION=1) asks for minimal animation.

    The whole Motion.axaml layer is dropped in that case (its effects are
    Style.Animations, which a later setter cannot neutralise). What remains here
    are the non-Motion transition/animation helpers defined by other style files.
  -->

  <Style Selector=":is(Control)">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>

  <Style Selector="Button.ui-btn:pointerover">
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.ui-btn:pressed">
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.decision-card:pointerover">
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.decision-card:pressed">
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.node-item:pointerover">
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>
  <Style Selector=":is(Control).hover-lift:pointerover">
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>
</Styles>
