<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surface primitives + control restyles (flat ink & hairline, no blur). -->

  <Style Selector="Border.surface">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowMd}" />
  </Style>

  <Style Selector="Border.surface-inset">
    <Setter Property="Background" Value="{DynamicResource GlassSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
  </Style>

  <Style Selector="Border.surface-elevated">
    <Setter Property="Background" Value="{DynamicResource GlassElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderLightBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXl}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowFloat}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowSm}" />
  </Style>

  <!-- UI button primitive: classes primary / quiet / ghost / danger × sm -->
  <Style Selector="Button.ui-btn">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="60" />
    <Setter Property="FontSize" Value="{DynamicResource FsMd}" />
    <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource GlassPillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="0.16,1,0.3,1" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.ui-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
  </Style>

  <Style Selector="Button.ui-btn:pressed">
    <Setter Property="Background" Value="{DynamicResource GlassPillActiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource GlassPillTextActiveBrush}" />
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>

  <Style Selector="Button.ui-btn:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="Button.ui-btn.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentContrastBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.ui-btn.primary:pointerover">
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <Style Selector="Button.ui-btn.danger">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentContrastBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.ui-btn.danger:pointerover">
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <Style Selector="Button.ui-btn.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.ui-btn.ghost:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.ui-btn.outline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="Button.ui-btn.outline:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Button.ui-btn.secondary">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.ui-btn.secondary:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderMidBrush}" />
  </Style>

  <!-- quiet: surface + hairline (web outline). Replaces the legacy default look. -->
  <Style Selector="Button.ui-btn.quiet">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.ui-btn.quiet:pointerover">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderMidBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.ui-btn.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.ui-btn.link:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource AccentAmberBrush}" />
  </Style>

  <Style Selector="Button.ui-btn.sm">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="FontSize" Value="{DynamicResource FsSm}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
  </Style>

  <Style Selector="Button.ui-btn.xs">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="FontSize" Value="{DynamicResource FsXs}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
  </Style>

  <Style Selector="Button.ui-btn.lg">
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="FontSize" Value="{DynamicResource FsMd}" />
  </Style>

  <Style Selector="Button.ui-btn.icon">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Command palette row item -->
  <Style Selector="Button.palette-item">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.palette-item:pointerover">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderMidBrush}" />
  </Style>
  <Style Selector="Button.palette-item.active">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.palette-item:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Fluent controls themed to the flat ink & hairline system -->
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="ComboBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="26" />
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="MinHeight" Value="26" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="{DynamicResource FsXs}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXl}" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
  </Style>

  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ScrollBar:pointerover /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource BorderMidBrush}" />
  </Style>

  <Style Selector="TextBlock.narrative">
    <Setter Property="FontFamily" Value="{DynamicResource FontNarrative}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="{DynamicResource LhNarrative}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
  </Style>

  <Style Selector="TextBlock.ui">
    <Setter Property="FontFamily" Value="{DynamicResource FontBody}" />
    <Setter Property="FontSize" Value="{DynamicResource FsMd}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{DynamicResource FontDisplay}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
    <Setter Property="FontSize" Value="{DynamicResource FsSm}" />
  </Style>

  <!-- Segmented view-mode tab (web: .view-tab-btn) -->
  <Style Selector="Button.seg">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource FsSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.25" />
        <BrushTransition Property="Foreground" Duration="0:0:0.25" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.seg:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.seg.active">
    <Setter Property="Background" Value="{DynamicResource GlassPillActiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource GlassPillTextActiveBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Header action pill (quick command / palette button) -->
  <Style Selector="Button.header-pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="{DynamicResource GlassPillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        <BrushTransition Property="Foreground" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.header-pill:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderMidBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- Header model pill (web: .header-active-model-pill) -->
  <Style Selector="Button.model-pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="Background" Value="{DynamicResource GlassPillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.model-pill:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderMidBrush}" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource MeterTrackBrush}" />
  </Style>
</Styles>
