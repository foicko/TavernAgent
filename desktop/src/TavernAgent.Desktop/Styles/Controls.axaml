<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:TavernAgent.Desktop.Controls">

  <!-- Pill tones (web: .ui-pill tones) -->
  <Style Selector="c|Pill Border#PillSurface">
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="c|Pill.sm Border#PillSurface">
    <Setter Property="Padding" Value="8,2" />
  </Style>
  <Style Selector="c|Pill.accent Border#PillSurface">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="c|Pill.accent TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentContrastBrush}" />
  </Style>
  <Style Selector="c|Pill.success Border#PillSurface">
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="c|Pill.warning Border#PillSurface">
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="c|Pill.info Border#PillSurface">
    <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
  </Style>
  <Style Selector="c|Pill.danger Border#PillSurface">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- ListRow hover -->
  <Style Selector="c|ListRow.interactive Border#RowSurface">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="c|ListRow.interactive:pointerover Border#RowSurface">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
  </Style>

  <!-- Banner tones -->
  <Style Selector="c|Banner.warning Border#BannerSurface">
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="c|Banner.danger Border#BannerSurface">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
  </Style>
  <Style Selector="c|Banner.success Border#BannerSurface">
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
  </Style>

  <Style Selector="Border.dragover">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
  </Style>

  <!-- v2: focus-visible rings (keyboard only) -->
  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ComboBox:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ToggleSwitch:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- v2: overlay / flyout / HUD surfaces -->
  <Style Selector="Border.overlay">
    <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderLightBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXl}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Elevation3}" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
  </Style>

  <!-- v2: relationship meters — tone comes from the VM, colours from tokens. -->
  <Style Selector="TextBlock.meter-value">
    <Setter Property="Foreground" Value="{DynamicResource MeterFillBrush}" />
  </Style>
  <Style Selector="TextBlock.meter-value.meter-aff">
    <Setter Property="Foreground" Value="{DynamicResource MeterAffBrush}" />
  </Style>
  <Style Selector="TextBlock.meter-value.meter-trust">
    <Setter Property="Foreground" Value="{DynamicResource MeterTrustBrush}" />
  </Style>
  <Style Selector="TextBlock.meter-value.meter-alert">
    <Setter Property="Foreground" Value="{DynamicResource MeterAlertBrush}" />
  </Style>
  <Style Selector="ProgressBar.meter-aff">
    <Setter Property="Foreground" Value="{DynamicResource MeterAffBrush}" />
  </Style>
  <Style Selector="ProgressBar.meter-trust">
    <Setter Property="Foreground" Value="{DynamicResource MeterTrustBrush}" />
  </Style>
  <Style Selector="ProgressBar.meter-alert">
    <Setter Property="Foreground" Value="{DynamicResource MeterAlertBrush}" />
  </Style>
  <Style Selector="TextBlock.meter-delta">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="TextBlock.meter-delta.pos">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <!-- v2: overlay scrollbars (auto-hide) so panels keep clean rounded edges -->
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>

  <!-- v2: icon-rail buttons (Dock spring physics inspired by beui.dev) -->
  <Style Selector="Button.rail-btn">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.rail-btn Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>
  <Style Selector="Button.rail-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.rail-btn:pointerover Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.rail-btn.active">
    <Setter Property="Background" Value="{DynamicResource GlassPillActiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource GlassPillTextActiveBrush}" />
  </Style>
  <Style Selector="Button.rail-btn.active Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource GlassPillTextActiveBrush}" />
  </Style>
  <!-- Remembered-but-closed tab: quiet marker so the rail keeps a sense of place. -->
  <Style Selector="Button.rail-btn.visited">
    <Setter Property="Background" Value="{DynamicResource GlassPillBrush}" />
  </Style>

  <!-- v2: ghost toolbar action that fades in on hover of its host -->
  <Style Selector="Button.ghost-action">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.ghost-action:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- Linear icons (web: ui/Icon): stroke-rendered geometry, 24×24 viewbox. -->
  <Style Selector="Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.icon.accent">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Path.icon.primary">
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Path.icon.danger">
    <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Path.icon.warn">
    <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="Button.ui-btn.primary Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource AccentContrastBrush}" />
  </Style>
  <Style Selector="Button.ui-btn.active Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource AccentContrastBrush}" />
  </Style>
  <Style Selector="Button.ui-btn.danger Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource AccentContrastBrush}" />
  </Style>

  <!-- Window Caption Buttons (Desktop Shell) -->
  <Style Selector="Button.caption-btn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.caption-btn Path">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.3" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.caption-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
  </Style>
  <Style Selector="Button.caption-btn:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.caption-btn:pressed">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
  </Style>

  <!-- Close button hover: Windows-native crimson alert state -->
  <Style Selector="Button.caption-btn.close-btn:pointerover">
    <Setter Property="Background" Value="#E81123" />
  </Style>
  <Style Selector="Button.caption-btn.close-btn:pointerover Path">
    <Setter Property="Stroke" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.caption-btn.close-btn:pressed">
    <Setter Property="Background" Value="#C4101E" />
  </Style>
  <Style Selector="Button.caption-btn.close-btn:pressed Path">
    <Setter Property="Stroke" Value="#FFFFFF" />
  </Style>
</Styles>
