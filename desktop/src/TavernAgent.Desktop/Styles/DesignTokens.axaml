<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Design tokens v3. Light = :root, Dark = [data-theme="dark"] (parity with tokens.css).
    v3 adopts the beautifului.dev "ink & hairline" flat system: opaque surfaces, single
    blue accent, hairline borders, soft low-opacity shadows, no glass/ambient. All legacy
    keys are preserved so DynamicResource references keep resolving.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="C.BgBase">#FAFAFB</Color>
      <Color x:Key="C.BgCanvas">#F1F2F3</Color>
      <Color x:Key="C.BgSurface">#FFFFFF</Color>
      <Color x:Key="C.BgSubtle">#F7F8F9</Color>
      <Color x:Key="C.BgElevated">#FFFFFF</Color>
      <Color x:Key="C.BorderLight">#ECEDEF</Color>
      <Color x:Key="C.BorderMid">#E0E2E5</Color>
      <Color x:Key="C.BorderDark">#1F2124</Color>
      <Color x:Key="C.BorderSubtle">#F4F5F6</Color>
      <Color x:Key="C.TextMain">#1F2124</Color>
      <Color x:Key="C.TextMuted">#62656B</Color>
      <Color x:Key="C.TextDim">#9A9DA3</Color>
      <Color x:Key="C.AccentSolid">#0285FF</Color>
      <Color x:Key="C.AccentContrast">#FFFFFF</Color>
      <Color x:Key="C.AccentSubtle">#1A0285FF</Color>
      <Color x:Key="C.AccentAmber">#EF720D</Color>
      <Color x:Key="C.AccentGreen">#199A4D</Color>
      <Color x:Key="C.Ring">#610285FF</Color>
      <Color x:Key="C.DangerText">#E3474C</Color>
      <Color x:Key="C.DangerBg">#14E3474C</Color>
      <Color x:Key="C.Success">#199A4D</Color>
      <Color x:Key="C.SuccessBg">#17199A4D</Color>
      <Color x:Key="C.Warning">#EF720D</Color>
      <Color x:Key="C.Info">#0285FF</Color>
      <Color x:Key="C.MeterTrack">#ECEDEF</Color>
      <Color x:Key="C.MeterFill">#0285FF</Color>
      <Color x:Key="C.MeterAff">#E3474C</Color>
      <Color x:Key="C.MeterTrust">#0285FF</Color>
      <Color x:Key="C.MeterAlert">#EF720D</Color>
      <!-- Glass keys retained but flattened to opaque surfaces (no translucency). -->
      <Color x:Key="C.GlassBg">#FFFFFF</Color>
      <Color x:Key="C.GlassBgSubtle">#F7F8F9</Color>
      <Color x:Key="C.GlassBgElevated">#FFFFFF</Color>
      <Color x:Key="C.GlassBorder">#ECEDEF</Color>
      <Color x:Key="C.GlassBorderLight">#ECEDEF</Color>
      <Color x:Key="C.GlassSpecularTop">#00FFFFFF</Color>
      <Color x:Key="C.GlassSpecularBottom">#001F2124</Color>
      <Color x:Key="C.GlassPillBg">#0D1F2124</Color>
      <Color x:Key="C.GlassPillBgHover">#171F2124</Color>
      <Color x:Key="C.GlassPillBgActive">#1F2124</Color>
      <Color x:Key="C.GlassPillTextActive">#FFFFFF</Color>
      <Color x:Key="C.WindowBg">#FAFAFB</Color>

      <!-- v2: no native material anymore — keep opaque for key compatibility. -->
      <Color x:Key="C.WindowBgMaterial">#FAFAFB</Color>

      <!-- v2: semantic surfaces -->
      <Color x:Key="C.SurfaceOverlay">#FFFFFF</Color>
      <Color x:Key="C.SurfaceSunken">#F7F8F9</Color>
      <Color x:Key="C.ScrimStrong">#8C1F2124</Color>
      <Color x:Key="C.Scrim">#800E0F12</Color>
      <Color x:Key="C.Highlight">#141F2124</Color>

      <!-- v2: ambient background removed (fully transparent). -->
      <Color x:Key="C.AmbientA">#003B82F6</Color>
      <Color x:Key="C.AmbientB">#0010B981</Color>
      <Color x:Key="C.AmbientC">#00B45309</Color>

      <BoxShadows x:Key="ShadowSm">0 1 2 0 #0F1F2124</BoxShadows>
      <BoxShadows x:Key="ShadowMd">0 2 8 0 #141F2124</BoxShadows>
      <BoxShadows x:Key="ShadowFloat">0 8 28 0 #1F1F2124</BoxShadows>
      <BoxShadows x:Key="Elevation1">0 1 2 0 #0A1F2124</BoxShadows>
      <BoxShadows x:Key="Elevation2">0 2 8 0 #121F2124</BoxShadows>
      <BoxShadows x:Key="Elevation3">0 8 24 0 #1A1F2124</BoxShadows>
      <BoxShadows x:Key="Elevation4">0 16 40 0 #241F2124</BoxShadows>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="C.BgBase">#17181A</Color>
      <Color x:Key="C.BgCanvas">#1C1D1F</Color>
      <Color x:Key="C.BgSurface">#232427</Color>
      <Color x:Key="C.BgSubtle">#1F2022</Color>
      <Color x:Key="C.BgElevated">#28292D</Color>
      <Color x:Key="C.BorderLight">#2E3033</Color>
      <Color x:Key="C.BorderMid">#3A3C40</Color>
      <Color x:Key="C.BorderDark">#F2F3F4</Color>
      <Color x:Key="C.BorderSubtle">#26272A</Color>
      <Color x:Key="C.TextMain">#F2F3F4</Color>
      <Color x:Key="C.TextMuted">#A5A8AD</Color>
      <Color x:Key="C.TextDim">#85888F</Color>
      <Color x:Key="C.AccentSolid">#3D9AFF</Color>
      <Color x:Key="C.AccentContrast">#FFFFFF</Color>
      <Color x:Key="C.AccentSubtle">#293D9AFF</Color>
      <Color x:Key="C.AccentAmber">#F68F3C</Color>
      <Color x:Key="C.AccentGreen">#3CBB72</Color>
      <Color x:Key="C.Ring">#6B3D9AFF</Color>
      <Color x:Key="C.DangerText">#EE5C61</Color>
      <Color x:Key="C.DangerBg">#24EE5C61</Color>
      <Color x:Key="C.Success">#3CBB72</Color>
      <Color x:Key="C.SuccessBg">#243CBB72</Color>
      <Color x:Key="C.Warning">#F68F3C</Color>
      <Color x:Key="C.Info">#3D9AFF</Color>
      <Color x:Key="C.MeterTrack">#2E3033</Color>
      <Color x:Key="C.MeterFill">#3D9AFF</Color>
      <Color x:Key="C.MeterAff">#EE5C61</Color>
      <Color x:Key="C.MeterTrust">#3D9AFF</Color>
      <Color x:Key="C.MeterAlert">#F68F3C</Color>
      <Color x:Key="C.GlassBg">#232427</Color>
      <Color x:Key="C.GlassBgSubtle">#1F2022</Color>
      <Color x:Key="C.GlassBgElevated">#28292D</Color>
      <Color x:Key="C.GlassBorder">#2E3033</Color>
      <Color x:Key="C.GlassBorderLight">#1FFFFFFF</Color>
      <Color x:Key="C.GlassSpecularTop">#00FFFFFF</Color>
      <Color x:Key="C.GlassSpecularBottom">#00000000</Color>
      <Color x:Key="C.GlassPillBg">#0FF2F3F4</Color>
      <Color x:Key="C.GlassPillBgHover">#1FF2F3F4</Color>
      <Color x:Key="C.GlassPillBgActive">#F2F3F4</Color>
      <Color x:Key="C.GlassPillTextActive">#17181A</Color>
      <Color x:Key="C.WindowBg">#17181A</Color>

      <Color x:Key="C.WindowBgMaterial">#17181A</Color>

      <Color x:Key="C.SurfaceOverlay">#232427</Color>
      <Color x:Key="C.SurfaceSunken">#17181A</Color>
      <Color x:Key="C.ScrimStrong">#A6000000</Color>
      <Color x:Key="C.Scrim">#800E0F12</Color>
      <Color x:Key="C.Highlight">#14FFFFFF</Color>

      <Color x:Key="C.AmbientA">#003B82F6</Color>
      <Color x:Key="C.AmbientB">#0010B981</Color>
      <Color x:Key="C.AmbientC">#00F59E0B</Color>

      <BoxShadows x:Key="ShadowSm">0 1 2 0 #4D000000</BoxShadows>
      <BoxShadows x:Key="ShadowMd">0 2 10 0 #3D000000</BoxShadows>
      <BoxShadows x:Key="ShadowFloat">0 8 28 0 #57000000</BoxShadows>
      <BoxShadows x:Key="Elevation1">0 1 3 0 #40000000</BoxShadows>
      <BoxShadows x:Key="Elevation2">0 4 14 0 #52000000</BoxShadows>
      <BoxShadows x:Key="Elevation3">0 10 28 0 #66000000</BoxShadows>
      <BoxShadows x:Key="Elevation4">0 20 48 0 #80000000</BoxShadows>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource C.WindowBg}" />
  <SolidColorBrush x:Key="WindowBackgroundMaterialBrush" Color="{DynamicResource C.WindowBgMaterial}" />
  <!-- App base painted by the shell; material variant kept for compatibility. -->
  <SolidColorBrush x:Key="AppBaseBrush" Color="{DynamicResource C.WindowBg}" />
  <SolidColorBrush x:Key="BgBaseBrush" Color="{DynamicResource C.BgBase}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource C.BgSurface}" />
  <SolidColorBrush x:Key="SubtleBrush" Color="{DynamicResource C.BgSubtle}" />
  <SolidColorBrush x:Key="ElevatedBrush" Color="{DynamicResource C.BgElevated}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource C.TextMain}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource C.TextMuted}" />
  <SolidColorBrush x:Key="TextDimBrush" Color="{DynamicResource C.TextDim}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource C.BorderLight}" />
  <SolidColorBrush x:Key="BorderMidBrush" Color="{DynamicResource C.BorderMid}" />
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="{DynamicResource C.BorderSubtle}" />
  <SolidColorBrush x:Key="BorderDarkBrush" Color="{DynamicResource C.BorderDark}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource C.AccentSolid}" />
  <SolidColorBrush x:Key="AccentContrastBrush" Color="{DynamicResource C.AccentContrast}" />
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="{DynamicResource C.AccentSubtle}" />
  <SolidColorBrush x:Key="AccentAmberBrush" Color="{DynamicResource C.AccentAmber}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource C.DangerText}" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="{DynamicResource C.DangerBg}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource C.Success}" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="{DynamicResource C.SuccessBg}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource C.Warning}" />
  <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource C.Info}" />
  <SolidColorBrush x:Key="RingBrush" Color="{DynamicResource C.Ring}" />
  <SolidColorBrush x:Key="MeterTrackBrush" Color="{DynamicResource C.MeterTrack}" />
  <SolidColorBrush x:Key="MeterFillBrush" Color="{DynamicResource C.MeterFill}" />
  <SolidColorBrush x:Key="MeterAffBrush" Color="{DynamicResource C.MeterAff}" />
  <SolidColorBrush x:Key="MeterTrustBrush" Color="{DynamicResource C.MeterTrust}" />
  <SolidColorBrush x:Key="MeterAlertBrush" Color="{DynamicResource C.MeterAlert}" />
  <SolidColorBrush x:Key="GlassBackgroundBrush" Color="{DynamicResource C.GlassBg}" />
  <SolidColorBrush x:Key="GlassSubtleBrush" Color="{DynamicResource C.GlassBgSubtle}" />
  <SolidColorBrush x:Key="GlassElevatedBrush" Color="{DynamicResource C.GlassBgElevated}" />
  <SolidColorBrush x:Key="GlassBorderBrush" Color="{DynamicResource C.GlassBorder}" />
  <SolidColorBrush x:Key="GlassBorderLightBrush" Color="{DynamicResource C.GlassBorderLight}" />
  <SolidColorBrush x:Key="GlassSpecularBrush" Color="{DynamicResource C.GlassSpecularTop}" />
  <SolidColorBrush x:Key="GlassPillBrush" Color="{DynamicResource C.GlassPillBg}" />
  <SolidColorBrush x:Key="GlassPillHoverBrush" Color="{DynamicResource C.GlassPillBgHover}" />
  <SolidColorBrush x:Key="GlassPillActiveBrush" Color="{DynamicResource C.GlassPillBgActive}" />
  <SolidColorBrush x:Key="GlassPillTextActiveBrush" Color="{DynamicResource C.GlassPillTextActive}" />
  <SolidColorBrush x:Key="ModalScrimBrush" Color="#6617181A" />
  <SolidColorBrush x:Key="ScrimBrush" Color="{DynamicResource C.Scrim}" />

  <!-- v2 brushes -->
  <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="{DynamicResource C.SurfaceOverlay}" />
  <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{DynamicResource C.SurfaceSunken}" />
  <SolidColorBrush x:Key="ScrimStrongBrush" Color="{DynamicResource C.ScrimStrong}" />
  <SolidColorBrush x:Key="HighlightBrush" Color="{DynamicResource C.Highlight}" />
  <SolidColorBrush x:Key="AmbientABrush" Color="{DynamicResource C.AmbientA}" />
  <SolidColorBrush x:Key="AmbientBBrush" Color="{DynamicResource C.AmbientB}" />
  <SolidColorBrush x:Key="AmbientCBrush" Color="{DynamicResource C.AmbientC}" />
  <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

  <!-- Typography (system stacks only — no bundled fonts) -->
  <FontFamily x:Key="FontBody">Inter, Segoe UI Variable Text, Segoe UI, SF Pro Text, -apple-system, Noto Sans CJK SC, Microsoft YaHei UI, Roboto, Helvetica, Arial, sans-serif</FontFamily>
  <FontFamily x:Key="FontDisplay">Inter, Segoe UI Variable Display, SF Pro Display, -apple-system, Microsoft YaHei UI, sans-serif</FontFamily>
  <FontFamily x:Key="FontNarrative">Noto Serif SC, Songti SC, Georgia, Microsoft YaHei, serif</FontFamily>
  <FontFamily x:Key="FontMono">Cascadia Mono, JetBrains Mono, Consolas, SFMono-Regular, Menlo, monospace</FontFamily>

  <!-- Spacing -->
  <x:Double x:Key="Space1">4</x:Double>
  <x:Double x:Key="Space2">8</x:Double>
  <x:Double x:Key="Space3">12</x:Double>
  <x:Double x:Key="Space4">16</x:Double>
  <x:Double x:Key="Space5">24</x:Double>
  <x:Double x:Key="Space6">32</x:Double>

  <!-- Radii: beautifului chip 6 / control 8 / card 10 / window 14 -->
  <CornerRadius x:Key="RadiusSm">6</CornerRadius>
  <CornerRadius x:Key="RadiusMd">8</CornerRadius>
  <CornerRadius x:Key="RadiusLg">10</CornerRadius>
  <CornerRadius x:Key="RadiusXl">14</CornerRadius>
  <CornerRadius x:Key="Radius2xl">18</CornerRadius>
  <CornerRadius x:Key="RadiusFull">999</CornerRadius>

  <!-- Layout skeleton (beautifului shell) -->
  <x:Double x:Key="HeaderHeightPx">48</x:Double>
  <x:Double x:Key="HeaderFloatHeightPx">48</x:Double>
  <x:Double x:Key="RingThickness">2</x:Double>
  <x:Double x:Key="RailIconWidth">52</x:Double>
  <x:Double x:Key="FlyoutWidth">224</x:Double>
  <x:Double x:Key="HudWidth">304</x:Double>
  <x:Double x:Key="RailLeftWidth">224</x:Double>
  <x:Double x:Key="RailRightWidth">304</x:Double>
  <x:Double x:Key="RailCollapsedWidth">52</x:Double>
  <x:Double x:Key="StageReadingWidth">820</x:Double>
  <x:Double x:Key="StageReadingModeWidth">820</x:Double>
  <x:Double x:Key="TachieHeight">290</x:Double>
  <x:Double x:Key="MeterTrackHeight">6</x:Double>

  <!-- Type scale -->
  <x:Double x:Key="FsXs">11</x:Double>
  <x:Double x:Key="FsSm">12</x:Double>
  <x:Double x:Key="FsMd">13.5</x:Double>
  <x:Double x:Key="FsLg">16</x:Double>
  <x:Double x:Key="FsXl">20</x:Double>
  <x:Double x:Key="Fs2xl">26</x:Double>
  <x:Double x:Key="LhTight">18.0</x:Double>
  <x:Double x:Key="LhNormal">22.0</x:Double>
  <x:Double x:Key="LhNarrative">26.0</x:Double>

  <!-- Motion (ms; easings as cubic-bezier control points) -->
  <x:Double x:Key="DurationMicroMs">80</x:Double>
  <x:Double x:Key="DurationQuickMs">150</x:Double>
  <x:Double x:Key="DurationFastMs">250</x:Double>
  <x:Double x:Key="DurationMediumMs">350</x:Double>
  <x:Double x:Key="DurationSlowMs">450</x:Double>
  <x:Double x:Key="DurationRailMs">240</x:Double>
  <x:Double x:Key="DurationEmphasizedMs">520</x:Double>

  <!-- EaseOutStrong is the beautifului house curve -->
  <x:String x:Key="EaseOutStrong">0.23,1,0.32,1</x:String>
  <x:String x:Key="EaseSmoothOut">0.23,1,0.32,1</x:String>
  <x:String x:Key="EaseSpring">0.16,1,0.3,1</x:String>
  <x:String x:Key="EaseBounce">0.34,1.36,0.64,1</x:String>
  <x:String x:Key="EaseStandard">0.2,0,0,1</x:String>
  <x:String x:Key="EaseEmphasized">0.2,0.8,0.2,1</x:String>

  <!-- Blur radii (kept for compatibility; no blur is applied by the flat system) -->
  <x:Double x:Key="BlurScrim">0</x:Double>
  <x:Double x:Key="BlurGlass">0</x:Double>
  <x:Double x:Key="BlurAmbient">0</x:Double>

  <!-- Z-index -->
  <x:Double x:Key="ZStage">0</x:Double>
  <x:Double x:Key="ZRail">10</x:Double>
  <x:Double x:Key="ZHeader">20</x:Double>
  <x:Double x:Key="ZFlyout">30</x:Double>
  <x:Double x:Key="ZModal">40</x:Double>
  <x:Double x:Key="ZPalette">50</x:Double>
  <x:Double x:Key="ZToast">60</x:Double>
</ResourceDictionary>
