<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Design tokens v2. Light = :root, Dark = [data-theme="dark"] (parity with tokens.css).
    v2 adds semantic surface/text layers, elevation, material, ambient, z-index and
    motion/spring tokens on top of the original contract (all legacy keys preserved).
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="C.BgBase">#F8FAFC</Color>
      <Color x:Key="C.BgCanvas">#F8FAFC</Color>
      <Color x:Key="C.BgSurface">#FFFFFF</Color>
      <Color x:Key="C.BgSubtle">#F1F5F9</Color>
      <Color x:Key="C.BgElevated">#FFFFFF</Color>
      <Color x:Key="C.BorderLight">#E2E8F0</Color>
      <Color x:Key="C.BorderMid">#CBD5E1</Color>
      <Color x:Key="C.BorderDark">#0F172A</Color>
      <Color x:Key="C.BorderSubtle">#F1F5F9</Color>
      <Color x:Key="C.TextMain">#0F172A</Color>
      <Color x:Key="C.TextMuted">#64748B</Color>
      <Color x:Key="C.TextDim">#94A3B8</Color>
      <Color x:Key="C.AccentSolid">#0F172A</Color>
      <Color x:Key="C.AccentContrast">#FFFFFF</Color>
      <Color x:Key="C.AccentSubtle">#0D0F172A</Color>
      <Color x:Key="C.AccentAmber">#B45309</Color>
      <Color x:Key="C.AccentGreen">#15803D</Color>
      <Color x:Key="C.Ring">#380F172A</Color>
      <Color x:Key="C.DangerText">#BE123C</Color>
      <Color x:Key="C.DangerBg">#0FBE123C</Color>
      <Color x:Key="C.Success">#16A34A</Color>
      <Color x:Key="C.Warning">#EA580C</Color>
      <Color x:Key="C.Info">#0284C7</Color>
      <Color x:Key="C.MeterTrack">#E2E8F0</Color>
      <Color x:Key="C.MeterFill">#0F172A</Color>
      <Color x:Key="C.MeterAff">#E11D48</Color>
      <Color x:Key="C.MeterTrust">#0284C7</Color>
      <Color x:Key="C.MeterAlert">#D97706</Color>
      <Color x:Key="C.GlassBg">#EBF8FAFC</Color>
      <Color x:Key="C.GlassBgSubtle">#DDF1F5F9</Color>
      <Color x:Key="C.GlassBgElevated">#FAFFFFFF</Color>
      <Color x:Key="C.GlassBorder">#1A0F172A</Color>
      <Color x:Key="C.GlassBorderLight">#E2E8F0</Color>
      <Color x:Key="C.GlassSpecularTop">#FAFFFFFF</Color>
      <Color x:Key="C.GlassSpecularBottom">#080F172A</Color>
      <Color x:Key="C.GlassPillBg">#0A0F172A</Color>
      <Color x:Key="C.GlassPillBgHover">#140F172A</Color>
      <Color x:Key="C.GlassPillBgActive">#0F172A</Color>
      <Color x:Key="C.GlassPillTextActive">#FFFFFF</Color>
      <Color x:Key="C.WindowBg">#F8FAFC</Color>

      <!-- v2: translucent base used when native window material is active -->
      <Color x:Key="C.WindowBgMaterial">#B8F8FAFC</Color>

      <!-- v2: semantic surfaces -->
      <Color x:Key="C.SurfaceOverlay">#F7FFFFFF</Color>
      <Color x:Key="C.SurfaceSunken">#F1F5F9</Color>
      <Color x:Key="C.ScrimStrong">#8C0F172A</Color>
      <Color x:Key="C.Highlight">#120F172A</Color>

      <!-- v2: ambient background (softened for pure white readability) -->
      <Color x:Key="C.AmbientA">#143B82F6</Color>
      <Color x:Key="C.AmbientB">#0F10B981</Color>
      <Color x:Key="C.AmbientC">#0DB45309</Color>

      <BoxShadows x:Key="ShadowSm">0 1 2 0 #0D0F172A, 0 1 1 0 #080F172A</BoxShadows>
      <BoxShadows x:Key="ShadowMd">0 4 12 -2 #120F172A, 0 2 4 -1 #080F172A</BoxShadows>
      <BoxShadows x:Key="ShadowFloat">0 16 36 -8 #1A0F172A</BoxShadows>
      <BoxShadows x:Key="Elevation1">0 1 3 0 #0A0F172A, 0 1 2 0 #050F172A</BoxShadows>
      <BoxShadows x:Key="Elevation2">0 4 12 -2 #0F0F172A, 0 2 6 -1 #080F172A</BoxShadows>
      <BoxShadows x:Key="Elevation3">0 12 32 -4 #140F172A, 0 4 12 -2 #0A0F172A</BoxShadows>
      <BoxShadows x:Key="Elevation4">0 24 56 -8 #1C0F172A, 0 8 20 -4 #100F172A</BoxShadows>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="C.BgBase">#09090B</Color>
      <Color x:Key="C.BgCanvas">#09090B</Color>
      <Color x:Key="C.BgSurface">#121215</Color>
      <Color x:Key="C.BgSubtle">#18181B</Color>
      <Color x:Key="C.BgElevated">#1C1C21</Color>
      <Color x:Key="C.BorderLight">#27272A</Color>
      <Color x:Key="C.BorderMid">#3F3F46</Color>
      <Color x:Key="C.BorderDark">#FAFAFA</Color>
      <Color x:Key="C.BorderSubtle">#18181B</Color>
      <Color x:Key="C.TextMain">#F8FAFC</Color>
      <Color x:Key="C.TextMuted">#A1A1AA</Color>
      <Color x:Key="C.TextDim">#71717A</Color>
      <Color x:Key="C.AccentSolid">#F8FAFC</Color>
      <Color x:Key="C.AccentContrast">#09090B</Color>
      <Color x:Key="C.AccentSubtle">#1FF8FAFC</Color>
      <Color x:Key="C.AccentAmber">#F59E0B</Color>
      <Color x:Key="C.AccentGreen">#22C55E</Color>
      <Color x:Key="C.Ring">#52F8FAFC</Color>
      <Color x:Key="C.DangerText">#FB7185</Color>
      <Color x:Key="C.DangerBg">#1AFB7185</Color>
      <Color x:Key="C.Success">#22C55E</Color>
      <Color x:Key="C.Warning">#F97316</Color>
      <Color x:Key="C.Info">#38BDF8</Color>
      <Color x:Key="C.MeterTrack">#27272A</Color>
      <Color x:Key="C.MeterFill">#F8FAFC</Color>
      <Color x:Key="C.MeterAff">#F43F5E</Color>
      <Color x:Key="C.MeterTrust">#0EA5E9</Color>
      <Color x:Key="C.MeterAlert">#F59E0B</Color>
      <Color x:Key="C.GlassBg">#E0121215</Color>
      <Color x:Key="C.GlassBgSubtle">#D918181B</Color>
      <Color x:Key="C.GlassBgElevated">#F21C1C21</Color>
      <Color x:Key="C.GlassBorder">#27272A</Color>
      <Color x:Key="C.GlassBorderLight">#33FFFFFF</Color>
      <Color x:Key="C.GlassSpecularTop">#26FFFFFF</Color>
      <Color x:Key="C.GlassSpecularBottom">#59000000</Color>
      <Color x:Key="C.GlassPillBg">#14F8FAFC</Color>
      <Color x:Key="C.GlassPillBgHover">#24F8FAFC</Color>
      <Color x:Key="C.GlassPillBgActive">#F8FAFC</Color>
      <Color x:Key="C.GlassPillTextActive">#09090B</Color>
      <Color x:Key="C.WindowBg">#09090B</Color>

      <!-- v2: translucent base used when native window material is active -->
      <Color x:Key="C.WindowBgMaterial">#B809090B</Color>

      <!-- v2: semantic surfaces -->
      <Color x:Key="C.SurfaceOverlay">#F018181B</Color>
      <Color x:Key="C.SurfaceSunken">#09090B</Color>
      <Color x:Key="C.ScrimStrong">#A6000000</Color>
      <Color x:Key="C.Highlight">#14FFFFFF</Color>

      <!-- v2: ambient background -->
      <Color x:Key="C.AmbientA">#1F3B82F6</Color>
      <Color x:Key="C.AmbientB">#1710B981</Color>
      <Color x:Key="C.AmbientC">#14F59E0B</Color>

      <BoxShadows x:Key="ShadowSm">0 1 2 0 #66000000</BoxShadows>
      <BoxShadows x:Key="ShadowMd">0 4 14 -2 #8C000000, 0 2 4 -1 #59000000</BoxShadows>
      <BoxShadows x:Key="ShadowFloat">0 20 48 -10 #BF000000</BoxShadows>
      <BoxShadows x:Key="Elevation1">0 1 3 0 #80000000</BoxShadows>
      <BoxShadows x:Key="Elevation2">0 6 18 -4 #A6000000, 0 2 6 -2 #80000000</BoxShadows>
      <BoxShadows x:Key="Elevation3">0 18 44 -10 #BF000000, 0 6 16 -4 #99000000</BoxShadows>
      <BoxShadows x:Key="Elevation4">0 32 72 -16 #E6000000, 0 10 24 -8 #B3000000</BoxShadows>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource C.WindowBg}" />
  <SolidColorBrush x:Key="WindowBackgroundMaterialBrush" Color="{DynamicResource C.WindowBgMaterial}" />
  <!-- App base painted by the ambient layer; swapped to the material variant when native blur is active. -->
  <SolidColorBrush x:Key="AppBaseBrush" Color="{DynamicResource C.WindowBg}" />
  <SolidColorBrush x:Key="BgBaseBrush" Color="{DynamicResource C.BgBase}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource C.BgSurface}" />
  <SolidColorBrush x:Key="SubtleBrush" Color="{DynamicResource C.BgSubtle}" />
  <SolidColorBrush x:Key="ElevatedBrush" Color="{DynamicResource C.BgElevated}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource C.TextMain}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource C.TextMuted}" />
  <SolidColorBrush x:Key="TextDimBrush" Color="{DynamicResource C.TextDim}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource C.BorderLight}" />
  <SolidColorBrush x:Key="BorderMidBrush" Color="{DynamicResource C.BorderMid}" />
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="{DynamicResource C.BorderSubtle}" />
  <SolidColorBrush x:Key="BorderDarkBrush" Color="{DynamicResource C.BorderDark}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource C.AccentSolid}" />
  <SolidColorBrush x:Key="AccentContrastBrush" Color="{DynamicResource C.AccentContrast}" />
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="{DynamicResource C.AccentSubtle}" />
  <SolidColorBrush x:Key="AccentAmberBrush" Color="{DynamicResource C.AccentAmber}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource C.DangerText}" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="{DynamicResource C.DangerBg}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource C.Success}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource C.Warning}" />
  <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource C.Info}" />
  <SolidColorBrush x:Key="RingBrush" Color="{DynamicResource C.Ring}" />
  <SolidColorBrush x:Key="MeterTrackBrush" Color="{DynamicResource C.MeterTrack}" />
  <SolidColorBrush x:Key="MeterFillBrush" Color="{DynamicResource C.MeterFill}" />
  <SolidColorBrush x:Key="MeterAffBrush" Color="{DynamicResource C.MeterAff}" />
  <SolidColorBrush x:Key="MeterTrustBrush" Color="{DynamicResource C.MeterTrust}" />
  <SolidColorBrush x:Key="MeterAlertBrush" Color="{DynamicResource C.MeterAlert}" />
  <SolidColorBrush x:Key="GlassBackgroundBrush" Color="{DynamicResource C.GlassBg}" />
  <SolidColorBrush x:Key="GlassSubtleBrush" Color="{DynamicResource C.GlassBgSubtle}" />
  <SolidColorBrush x:Key="GlassElevatedBrush" Color="{DynamicResource C.GlassBgElevated}" />
  <SolidColorBrush x:Key="GlassBorderBrush" Color="{DynamicResource C.GlassBorder}" />
  <SolidColorBrush x:Key="GlassBorderLightBrush" Color="{DynamicResource C.GlassBorderLight}" />
  <SolidColorBrush x:Key="GlassSpecularBrush" Color="{DynamicResource C.GlassSpecularTop}" />
  <SolidColorBrush x:Key="GlassPillBrush" Color="{DynamicResource C.GlassPillBg}" />
  <SolidColorBrush x:Key="GlassPillHoverBrush" Color="{DynamicResource C.GlassPillBgHover}" />
  <SolidColorBrush x:Key="GlassPillActiveBrush" Color="{DynamicResource C.GlassPillBgActive}" />
  <SolidColorBrush x:Key="GlassPillTextActiveBrush" Color="{DynamicResource C.GlassPillTextActive}" />
  <SolidColorBrush x:Key="ModalScrimBrush" Color="#800E0F12" />

  <!-- v2 brushes -->
  <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="{DynamicResource C.SurfaceOverlay}" />
  <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{DynamicResource C.SurfaceSunken}" />
  <SolidColorBrush x:Key="ScrimStrongBrush" Color="{DynamicResource C.ScrimStrong}" />
  <SolidColorBrush x:Key="HighlightBrush" Color="{DynamicResource C.Highlight}" />
  <SolidColorBrush x:Key="AmbientABrush" Color="{DynamicResource C.AmbientA}" />
  <SolidColorBrush x:Key="AmbientBBrush" Color="{DynamicResource C.AmbientB}" />
  <SolidColorBrush x:Key="AmbientCBrush" Color="{DynamicResource C.AmbientC}" />
  <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

  <!-- Typography (system stacks only — no bundled fonts) -->
  <FontFamily x:Key="FontBody">Segoe UI Variable Text, Segoe UI, SF Pro Text, -apple-system, Noto Sans CJK SC, Microsoft YaHei UI, Roboto, Helvetica, Arial, sans-serif</FontFamily>
  <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, SF Pro Display, -apple-system, Noto Serif SC, Georgia, Songti SC, serif</FontFamily>
  <FontFamily x:Key="FontNarrative">Noto Serif SC, Songti SC, Georgia, Microsoft YaHei, serif</FontFamily>
  <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, SFMono-Regular, Menlo, monospace</FontFamily>

  <!-- Spacing -->
  <x:Double x:Key="Space1">4</x:Double>
  <x:Double x:Key="Space2">8</x:Double>
  <x:Double x:Key="Space3">12</x:Double>
  <x:Double x:Key="Space4">16</x:Double>
  <x:Double x:Key="Space5">24</x:Double>
  <x:Double x:Key="Space6">32</x:Double>

  <CornerRadius x:Key="RadiusSm">6</CornerRadius>
  <CornerRadius x:Key="RadiusMd">10</CornerRadius>
  <CornerRadius x:Key="RadiusLg">14</CornerRadius>
  <CornerRadius x:Key="RadiusXl">18</CornerRadius>
  <CornerRadius x:Key="Radius2xl">24</CornerRadius>
  <CornerRadius x:Key="RadiusFull">999</CornerRadius>

  <!-- Layout skeleton -->
  <x:Double x:Key="HeaderHeightPx">52</x:Double>
  <x:Double x:Key="HeaderFloatHeightPx">44</x:Double>
  <x:Double x:Key="RailIconWidth">56</x:Double>
  <x:Double x:Key="FlyoutWidth">328</x:Double>
  <x:Double x:Key="HudWidth">320</x:Double>
  <x:Double x:Key="RailLeftWidth">285</x:Double>
  <x:Double x:Key="RailRightWidth">320</x:Double>
  <x:Double x:Key="RailCollapsedWidth">48</x:Double>
  <x:Double x:Key="StageReadingWidth">820</x:Double>
  <x:Double x:Key="StageReadingModeWidth">760</x:Double>
  <x:Double x:Key="TachieHeight">290</x:Double>
  <x:Double x:Key="MeterTrackHeight">6</x:Double>

  <!-- Type scale -->
  <x:Double x:Key="FsXs">11</x:Double>
  <x:Double x:Key="FsSm">12</x:Double>
  <x:Double x:Key="FsMd">13.5</x:Double>
  <x:Double x:Key="FsLg">16</x:Double>
  <x:Double x:Key="FsXl">20</x:Double>
  <x:Double x:Key="Fs2xl">26</x:Double>
  <x:Double x:Key="LhTight">1.35</x:Double>
  <x:Double x:Key="LhNormal">1.6</x:Double>
  <x:Double x:Key="LhNarrative">1.78</x:Double>

  <!-- Motion (ms; easings as cubic-bezier control points) -->
  <x:Double x:Key="DurationMicroMs">80</x:Double>
  <x:Double x:Key="DurationQuickMs">150</x:Double>
  <x:Double x:Key="DurationFastMs">250</x:Double>
  <x:Double x:Key="DurationMediumMs">350</x:Double>
  <x:Double x:Key="DurationSlowMs">450</x:Double>
  <x:Double x:Key="DurationRailMs">240</x:Double>
  <x:Double x:Key="DurationEmphasizedMs">520</x:Double>

  <x:String x:Key="EaseSmoothOut">0.22,1,0.36,1</x:String>
  <x:String x:Key="EaseSpring">0.16,1,0.3,1</x:String>
  <x:String x:Key="EaseBounce">0.34,1.36,0.64,1</x:String>
  <x:String x:Key="EaseStandard">0.2,0,0,1</x:String>
  <x:String x:Key="EaseEmphasized">0.2,0.8,0.2,1</x:String>

  <!-- Blur radii -->
  <x:Double x:Key="BlurScrim">8</x:Double>
  <x:Double x:Key="BlurGlass">14</x:Double>
  <x:Double x:Key="BlurAmbient">64</x:Double>

  <!-- Z-index -->
  <x:Double x:Key="ZStage">0</x:Double>
  <x:Double x:Key="ZRail">10</x:Double>
  <x:Double x:Key="ZHeader">20</x:Double>
  <x:Double x:Key="ZFlyout">30</x:Double>
  <x:Double x:Key="ZModal">40</x:Double>
  <x:Double x:Key="ZPalette">50</x:Double>
  <x:Double x:Key="ZToast">60</x:Double>
</ResourceDictionary>
