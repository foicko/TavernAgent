<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:TavernAgent.Desktop.Controls">

  <!-- Narrative block typography (web: .block-narration / .block-dialogue / .block-monologue) -->
  <Style Selector="c|InlineMarkdownText.narration">
    <Setter Property="FontFamily" Value="{DynamicResource FontNarrative}" />
    <Setter Property="FontSize" Value="15.5" />
    <Setter Property="LineHeight" Value="1.85" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="c|InlineMarkdownText.dialogue">
    <Setter Property="FontFamily" Value="{DynamicResource FontNarrative}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="1.8" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="c|InlineMarkdownText.monologue">
    <Setter Property="FontFamily" Value="{DynamicResource FontNarrative}" />
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="LineHeight" Value="1.75" />
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
  </Style>

  <!-- Evidence chip: inset surface + hairline (web: .evidence-chip / .ui-pill) -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusFull}" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBlock.up">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.down">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- Decision card (ApprovalCard inspired by beautifului.dev) -->
  <Style Selector="Button.decision-card">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="0.23,1,0.32,1" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.decision-card:pointerover">
    <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderMidBrush}" />
    <Setter Property="RenderTransform" Value="translateY(-1px)" />
  </Style>
  <Style Selector="Button.decision-card:pressed">
    <Setter Property="RenderTransform" Value="scale(0.99)" />
  </Style>

  <!-- Thinking card (ThinkingState inspired by beautifului.dev) -->
  <Style Selector="Border.thinking-card">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.thinking-card:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderMidBrush}" />
  </Style>
  <!-- Live thinking: the status line breathes while the model reasons (28-thinking-states) -->
  <Style Selector="Border.thinking-card.live TextBlock.thinking-title">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Style.Animations>
      <Animation Duration="0:0:1.8" IterationCount="INFINITE" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.thinking-card.live Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Skeleton shimmer -->
  <Style Selector="Border.skeleton">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Style.Animations>
      <Animation Duration="0:0:1.8" IterationCount="INFINITE" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Typing cursor blink (2px vertical pulse) -->
  <Style Selector="Border.cursor-line">
    <Setter Property="Width" Value="2" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="CornerRadius" Value="1" />
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.05" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="TextBlock.cursor">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Button.has-note">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>

  <!-- Turn actions fade in on hover / focus (web: .turn-quick-toolbar) -->
  <Style Selector="StackPanel.msg-actions">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.msg-card:pointerover StackPanel.msg-actions">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Border.msg-card:focus-within StackPanel.msg-actions">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Border.msg-card">
    <Setter Property="Transitions">
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.msg-card:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderMidBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowMd}" />
  </Style>

  <!-- Composer island: flat surface card; focus paints the accent hairline (web: .composer-card-shell) -->
  <Style Selector="Border.composer-island">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.composer-island:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowMd}" />
  </Style>

  <!-- Disclosure caret rotates when open -->
  <Style Selector="Path.disclosure-caret">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="0.23,1,0.32,1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Path.disclosure-caret.open">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>
</Styles>
