<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:TavernAgent.Desktop.Controls">

  <!-- Narrative block typography (web: .block-narration / .block-dialogue / .block-monologue) -->
  <Style Selector="c|InlineMarkdownText.narration">
    <Setter Property="FontFamily" Value="{DynamicResource FontNarrative}" />
    <Setter Property="FontSize" Value="15.5" />
    <Setter Property="LineHeight" Value="1.85" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="c|InlineMarkdownText.dialogue">
    <Setter Property="FontFamily" Value="{DynamicResource FontNarrative}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="1.8" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="c|InlineMarkdownText.monologue">
    <Setter Property="FontFamily" Value="{DynamicResource FontNarrative}" />
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="LineHeight" Value="1.75" />
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
  </Style>

  <!-- Evidence chip -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Background" Value="{DynamicResource GlassPillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBlock.up">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.down">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- Decision card -->
  <Style Selector="Button.decision-card">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Background" Value="{DynamicResource GlassPillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.decision-card:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
    <Setter Property="RenderTransform" Value="translateY(-2px)" />
  </Style>

  <!-- Skeleton shimmer -->
  <Style Selector="Border.skeleton">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Style.Animations>
      <Animation Duration="0:0:1.8" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.45" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.45" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Typing cursor blink -->
  <Style Selector="TextBlock.cursor">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Button.has-note">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>

  <!-- v2: turn actions fade in on hover / focus -->
  <Style Selector="StackPanel.msg-actions">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.msg-card:pointerover StackPanel.msg-actions">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Border.msg-card:focus-within StackPanel.msg-actions">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Border.msg-card">
    <Setter Property="Transitions">
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.msg-card:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderLightBrush}" />
  </Style>

  <!-- v2: composer island morphs on focus -->
  <Style Selector="Border.composer-island">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.22" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.composer-island:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="RenderTransform" Value="translateY(-2px)" />
  </Style>
</Styles>
