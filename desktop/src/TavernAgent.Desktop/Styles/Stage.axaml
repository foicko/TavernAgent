<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:TavernAgent.Desktop.Controls">

  <Style Selector="c|InlineMarkdownText">
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Macro pill: compact full-radius helper in composer -->
  <Style Selector="Button.macro-pill">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusFull}" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource FsXs}" />
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.macro-pill:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderMidBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- [+] Action Menu button in bottom composer -->
  <Style Selector="Button.action-plus-btn">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusFull}" />
    <Setter Property="Background" Value="{DynamicResource GlassPillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="0.23,1,0.32,1" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.action-plus-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderMidBrush}" />
    <Setter Property="RenderTransform" Value="scale(1.06)" />
  </Style>
  <Style Selector="Button.action-plus-btn:pressed">
    <Setter Property="RenderTransform" Value="scale(0.94)" />
  </Style>

  <!-- Composer pill button (e.g. Context token donut button) -->
  <Style Selector="Button.composer-pill-btn">
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusFull}" />
    <Setter Property="Background" Value="{DynamicResource GlassPillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.composer-pill-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderMidBrush}" />
  </Style>

  <!-- Active mode indicator pills (Director, Action, Note badges) -->
  <Style Selector="Button.active-mode-pill">
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusFull}" />
    <Setter Property="Background" Value="{DynamicResource GlassPillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="9,2" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.active-mode-pill:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderMidBrush}" />
    <Setter Property="RenderTransform" Value="scale(1.02)" />
  </Style>
  <Style Selector="Button.active-mode-pill:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>

  <!-- Flyout row button for [+] action menu -->
  <Style Selector="Button.menu-action-item">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.menu-action-item:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
  </Style>
  <Style Selector="Button.menu-action-item:pressed">
    <Setter Property="RenderTransform" Value="scale(0.98)" />
  </Style>

  <!-- Circular Send / Stop button -->
  <Style Selector="Button.send-circle-btn">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="0.23,1,0.32,1" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.send-circle-btn.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentContrastBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.send-circle-btn.primary:pointerover">
    <Setter Property="Opacity" Value="0.9" />
    <Setter Property="RenderTransform" Value="scale(1.06)" />
  </Style>
  <Style Selector="Button.send-circle-btn.danger">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentContrastBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.send-circle-btn.danger:pointerover">
    <Setter Property="Opacity" Value="0.9" />
    <Setter Property="RenderTransform" Value="scale(1.06)" />
  </Style>
  <Style Selector="Button.send-circle-btn.quiet">
    <Setter Property="Background" Value="{DynamicResource GlassPillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.send-circle-btn.quiet:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderMidBrush}" />
    <Setter Property="RenderTransform" Value="scale(1.06)" />
  </Style>
  <Style Selector="Button.send-circle-btn:pressed">
    <Setter Property="RenderTransform" Value="scale(0.94)" />
  </Style>
  <Style Selector="Button.send-circle-btn:disabled">
    <Setter Property="Background" Value="{DynamicResource BgCanvasBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Narrative block typography (web: .block-narration / .block-dialogue / .block-monologue) -->
  <Style Selector="c|InlineMarkdownText.narration">
    <Setter Property="FontFamily" Value="{DynamicResource FontNarrative}" />
    <Setter Property="FontSize" Value="15.5" />
    <Setter Property="LineHeight" Value="27" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="c|InlineMarkdownText.dialogue">
    <Setter Property="FontFamily" Value="{DynamicResource FontNarrative}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="26" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="c|InlineMarkdownText.monologue">
    <Setter Property="FontFamily" Value="{DynamicResource FontNarrative}" />
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="LineHeight" Value="25" />
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
  </Style>

  <!-- Evidence chip: inset surface + hairline (web: .evidence-chip / .ui-pill) -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusFull}" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBlock.up">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.down">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- Decision card: stacked interactive choice card -->
  <Style Selector="Button.decision-card">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="12,10,14,10" />
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="0.23,1,0.32,1" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.decision-card:pointerover">
    <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderMidBrush}" />
    <Setter Property="RenderTransform" Value="translateX(3px)" />
  </Style>
  <Style Selector="Button.decision-card:pressed">
    <Setter Property="RenderTransform" Value="scale(0.995)" />
  </Style>
  <Style Selector="Button.decision-card:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- 意图色竖条：贴在卡片左缘，两端圆头 -->
  <Style Selector="Border.decision-stripe">
    <Setter Property="Width" Value="3" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusFull}" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Margin" Value="0,1" />
  </Style>

  <!-- 意图标签药丸：中性底 + 强调色图标 -->
  <Style Selector="Border.intent-pill">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusFull}" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <!-- 「选定 ⏎」提示：hover 时点亮并轻微右移 -->
  <Style Selector="Button.decision-card StackPanel.decision-hint TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
  </Style>
  <Style Selector="Button.decision-card StackPanel.decision-hint Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource TextDimBrush}" />
  </Style>
  <Style Selector="StackPanel.decision-hint">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="0.23,1,0.32,1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.decision-card:pointerover StackPanel.decision-hint">
    <Setter Property="RenderTransform" Value="translateX(2px)" />
  </Style>
  <Style Selector="Button.decision-card:pointerover StackPanel.decision-hint TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.decision-card:pointerover StackPanel.decision-hint Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Thinking card (ThinkingState inspired by beautifului.dev) -->
  <Style Selector="Border.thinking-card">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.thinking-card:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderMidBrush}" />
  </Style>
  <!-- Live thinking: the status line breathes while the model reasons (28-thinking-states) -->
  <Style Selector="Border.thinking-card.live TextBlock.thinking-title">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Style.Animations>
      <Animation Duration="0:0:1.8" IterationCount="INFINITE" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.thinking-card.live Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Skeleton shimmer -->
  <Style Selector="Border.skeleton">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    <Style.Animations>
      <Animation Duration="0:0:1.8" IterationCount="INFINITE" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Typing cursor blink (2px vertical pulse) -->
  <Style Selector="Border.cursor-line">
    <Setter Property="Width" Value="2" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="CornerRadius" Value="1" />
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.05" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="TextBlock.cursor">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Button.has-note">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>

  <!-- Turn actions fade in on hover / focus (web: .turn-quick-toolbar) -->
  <Style Selector="StackPanel.msg-actions">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.msg-card:pointerover StackPanel.msg-actions">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Border.msg-card:focus-within StackPanel.msg-actions">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Border.msg-card">
    <Setter Property="Transitions">
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.msg-card:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderMidBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowMd}" />
  </Style>

  <!-- Composer island: flat surface card; focus paints a refined hairline + soft elevation -->
  <Style Selector="Border.composer-island">
    <Setter Property="Background" Value="{DynamicResource ComposerIslandBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ComposerIslandBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="{DynamicResource ShadowFloat}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.composer-island:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderMidBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Elevation4}" />
  </Style>

  <!-- Seamless composer input textbox (no nested gray box) -->
  <Style Selector="TextBox.composer-input">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,4" />
    <Setter Property="FontSize" Value="{DynamicResource FsMd}" />
    <Setter Property="LineHeight" Value="22" />
  </Style>
  <Style Selector="TextBox.composer-input /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.composer-input:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.composer-input:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Composer bottom combobox pills -->
  <Style Selector="ComboBox.composer-pill">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusFull}" />
    <Setter Property="Background" Value="{DynamicResource GlassPillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MaxHeight" Value="28" />
    <Setter Property="Padding" Value="8,2,6,2" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource FsXs}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox.composer-pill:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
  </Style>
  <Style Selector="ComboBox.composer-pill:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Disclosure caret rotates when open -->
  <Style Selector="Path.disclosure-caret">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="0.23,1,0.32,1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Path.disclosure-caret.open">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>
</Styles>
