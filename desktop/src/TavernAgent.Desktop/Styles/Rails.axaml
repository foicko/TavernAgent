<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Left rail sub-tabs -->
  <Style Selector="Button.subtab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="FontSize" Value="{DynamicResource FsXs}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.subtab:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
  </Style>
  <Style Selector="Button.subtab.active">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentContrastBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Collapsed dock icons -->
  <Style Selector="Button.dock">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.dock.active">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentContrastBrush}" />
  </Style>

  <!-- Branch node -->
  <Style Selector="Button.node-item">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Background" Value="{DynamicResource GlassSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.node-item:pointerover">
    <Setter Property="RenderTransform" Value="translateX(3px)" />
  </Style>
  <Style Selector="Button.node-item.active">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.node-item.viewing">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
  </Style>

  <!-- State pill / metric chip -->
  <Style Selector="Border.state-pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
  </Style>
  <Style Selector="Border.state-pill.active">
    <Setter Property="Background" Value="#1410B981" />
  </Style>
  <Style Selector="Border.state-pill TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.state-pill.active TextBlock">
    <Setter Property="Foreground" Value="#059669" />
  </Style>
  <Style Selector="Border.metric-chip">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
  </Style>

  <!-- Card rows -->
  <Style Selector="Border.char-card">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="8,8" />
    <Setter Property="Background" Value="{DynamicResource GlassSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.char-card.active">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.char-card.confirming">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
  </Style>

  <Style Selector="Border.session-card">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Background" Value="{DynamicResource GlassSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.session-card.active">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Button.card-open">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.card-open:pointerover">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Story map node -->
  <Style Selector="Button.map-node">
    <Setter Property="Width" Value="160" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Background" Value="{DynamicResource GlassSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.map-node.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Right rail HUD tile -->
  <Style Selector="Button.hud-tile">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="Background" Value="{DynamicResource GlassSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.hud-tile:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
  </Style>

  <!-- Inventory slot + bubble act -->
  <Style Selector="Button.item-slot">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Background" Value="{DynamicResource GlassSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.item-slot:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
  </Style>
  <Style Selector="Button.item-act">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="FontSize" Value="{DynamicResource FsXs}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.item-act:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
  </Style>

  <!-- Generic active toggle for ui-btn filters -->
  <Style Selector="Button.ui-btn.active">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentContrastBrush}" />
  </Style>

  <!-- Meter delta float -->
  <Style Selector="TextBlock.meter-delta">
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="1">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="6" />
        </KeyFrame>
        <KeyFrame Cue="20%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="60%">
          <Setter Property="TranslateTransform.Y" Value="-8" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="-16" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
