<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Controls.EmptyState">
  <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
    <TextBlock Text="{Binding $parent[controls:EmptyState].Icon}"
               FontSize="28"
               HorizontalAlignment="Center"
               Opacity="0.7" />
    <TextBlock Text="{Binding $parent[controls:EmptyState].Title}"
               IsVisible="{Binding $parent[controls:EmptyState].Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               FontSize="{DynamicResource FsMd}"
               FontWeight="Medium"
               TextWrapping="Wrap"
               TextAlignment="Center"
               Foreground="{DynamicResource TextPrimaryBrush}" />
    <TextBlock Text="{Binding $parent[controls:EmptyState].Description}"
               IsVisible="{Binding $parent[controls:EmptyState].Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               FontSize="{DynamicResource FsSm}"
               TextWrapping="Wrap"
               TextAlignment="Center"
               MaxWidth="320"
               Foreground="{DynamicResource TextSecondaryBrush}" />
    <ContentPresenter Content="{Binding $parent[controls:EmptyState].Body}"
                      HorizontalAlignment="Center"
                      Margin="0,4,0,0" />
  </StackPanel>
</UserControl>
