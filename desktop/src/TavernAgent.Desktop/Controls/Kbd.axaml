<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Controls.Kbd">
  <Border Background="{DynamicResource SubtleBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource RadiusSm}"
          Padding="5,1"
          MinWidth="20"
          VerticalAlignment="Center">
    <TextBlock Text="{Binding $parent[controls:Kbd].Text}"
               FontFamily="{DynamicResource FontMono}"
               FontSize="{DynamicResource FsXs}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Foreground="{DynamicResource TextSecondaryBrush}" />
  </Border>
</UserControl>
