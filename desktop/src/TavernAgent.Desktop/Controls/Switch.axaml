<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Controls.Switch">
  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <ToggleSwitch Name="Toggle"
                  IsChecked="{Binding $parent[controls:Switch].IsChecked, Mode=TwoWay}"
                  OnContent=""
                  OffContent=""
                  VerticalAlignment="Center" />
    <ContentPresenter Content="{Binding $parent[controls:Switch].Body}" VerticalAlignment="Center" />
  </StackPanel>
</UserControl>
