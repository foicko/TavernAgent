<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Controls.Modal"
             Focusable="True">
  <Grid>
    <!-- Flat scrim (beautifului): opaque tint, no blur (web scrim token) -->
    <Border Name="Scrim" Background="{DynamicResource ScrimBrush}" />

    <Border Name="Card"
            Classes="surface-elevated anim-pop"
            Margin="24"
            MaxWidth="{Binding $parent[controls:Modal].DialogWidth}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MinWidth="280">
      <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="20,16,12,12">
          <TextBlock Grid.Column="0"
                     Text="{Binding $parent[controls:Modal].Title}"
                     FontSize="{DynamicResource FsLg}"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <Button Grid.Column="1" Classes="icon soft-brush" Name="CloseButton" ToolTip.Tip="关闭">
            <Path Classes="icon" Data="{StaticResource IconClose}" Width="14" Height="14" />
          </Button>
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderBrush}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ContentPresenter Content="{Binding $parent[controls:Modal].Body}" Margin="20,16,20,20" />
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
