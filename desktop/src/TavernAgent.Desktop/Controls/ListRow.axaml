<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Controls.ListRow">
  <Border Name="RowSurface"
          CornerRadius="{DynamicResource RadiusMd}"
          Padding="10,8"
          Background="Transparent">
    <ContentPresenter Content="{Binding $parent[controls:ListRow].Body}" />
  </Border>
</UserControl>
