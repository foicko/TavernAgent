<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Controls.Skeleton">
  <Border Background="{DynamicResource SubtleBrush}"
          CornerRadius="{Binding $parent[controls:Skeleton].Radius}"
          Classes="anim-pulse" />
</UserControl>
