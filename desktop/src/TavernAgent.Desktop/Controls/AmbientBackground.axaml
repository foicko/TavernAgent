<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Controls.AmbientBackground"
             IsHitTestVisible="False">
  <UserControl.Styles>
    <Style Selector="Ellipse#OrbA.drift">
      <Style.Animations>
        <Animation Duration="0:0:28" IterationCount="INFINITE" Easing="SineEaseInOut" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%">
            <Setter Property="TranslateTransform.X" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="0" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="TranslateTransform.X" Value="72" />
            <Setter Property="TranslateTransform.Y" Value="54" />
            <Setter Property="ScaleTransform.ScaleX" Value="1.14" />
            <Setter Property="ScaleTransform.ScaleY" Value="1.14" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Ellipse#OrbB.drift">
      <Style.Animations>
        <Animation Duration="0:0:34" IterationCount="INFINITE" Easing="SineEaseInOut" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%">
            <Setter Property="TranslateTransform.X" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="0" />
            <Setter Property="ScaleTransform.ScaleX" Value="1.05" />
            <Setter Property="ScaleTransform.ScaleY" Value="1.05" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="TranslateTransform.X" Value="-64" />
            <Setter Property="TranslateTransform.Y" Value="-40" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Ellipse#OrbC.drift">
      <Style.Animations>
        <Animation Duration="0:0:22" IterationCount="INFINITE" Easing="SineEaseInOut" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%">
            <Setter Property="TranslateTransform.X" Value="-40" />
            <Setter Property="TranslateTransform.Y" Value="20" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="TranslateTransform.X" Value="46" />
            <Setter Property="TranslateTransform.Y" Value="-28" />
            <Setter Property="ScaleTransform.ScaleX" Value="1.1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1.1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <Panel ClipToBounds="True" Background="{DynamicResource AppBaseBrush}">
    <Panel Name="OrbLayer" Opacity="{Binding $parent[controls:AmbientBackground].Intensity}">
      <Ellipse Name="OrbA" Width="820" Height="820"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-240,-300,0,0">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Offset="0" Color="{DynamicResource C.AmbientA}" />
            <GradientStop Offset="0.62" Color="#00000000" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <Ellipse Name="OrbB" Width="720" Height="720"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-200,-240">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Offset="0" Color="{DynamicResource C.AmbientB}" />
            <GradientStop Offset="0.6" Color="#00000000" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <Ellipse Name="OrbC" Width="560" Height="560"
               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,120,0,0">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Offset="0" Color="{DynamicResource C.AmbientC}" />
            <GradientStop Offset="0.55" Color="#00000000" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
    </Panel>
  </Panel>
</UserControl>
