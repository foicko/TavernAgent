<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Controls.Disclosure">
  <StackPanel Spacing="8">
    <ToggleButton Name="HeaderToggle"
                  IsChecked="{Binding $parent[controls:Disclosure].IsExpanded, Mode=TwoWay}"
                  HorizontalContentAlignment="Stretch"
                  HorizontalAlignment="Stretch"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="4">
      <Grid ColumnDefinitions="Auto,*">
        <!-- Chevron rotates 90deg when expanded (web: .ui-disclosure__caret) -->
        <Path Grid.Column="0" Classes="icon disclosure-caret"
              Data="{StaticResource IconChevronRight}"
              Width="13" Height="13" Margin="0,0,8,0"
              Classes.open="{Binding $parent[controls:Disclosure].IsExpanded}" />
        <TextBlock Grid.Column="1"
                   Text="{Binding $parent[controls:Disclosure].Header}"
                   FontSize="{DynamicResource FsMd}"
                   FontWeight="Medium"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
      </Grid>
    </ToggleButton>
    <ContentPresenter Content="{Binding $parent[controls:Disclosure].Body}"
                      IsVisible="{Binding $parent[controls:Disclosure].IsExpanded}" />
  </StackPanel>
</UserControl>
