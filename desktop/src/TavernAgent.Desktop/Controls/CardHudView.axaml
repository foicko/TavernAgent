<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TavernAgent.Desktop.ViewModels.Stage"
             x:Class="TavernAgent.Desktop.Controls.CardHudView"
             x:DataType="vm:NarrativeHudSegment">
  <StackPanel Spacing="6">
    <!-- Scene chip -->
    <Border IsVisible="{Binding IsScene}"
            HorizontalAlignment="Left"
            CornerRadius="999" Padding="10,4"
            Background="{DynamicResource GlassPillBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="场景" FontSize="{DynamicResource FsXs}"
                   Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FsSm}"
                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Status panel -->
    <Border IsVisible="{Binding !IsScene}"
            CornerRadius="{DynamicResource RadiusMd}" Padding="12,10"
            Background="{DynamicResource GlassBackgroundBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
      <StackPanel Spacing="6">
        <TextBlock Text="状态" FontSize="{DynamicResource FsXs}"
                   Foreground="{DynamicResource TextDimBrush}" />
        <ItemsControl ItemsSource="{Binding Values}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HudRow">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,1">
                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="{DynamicResource FsSm}"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Value}" FontSize="{DynamicResource FsSm}"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                  <ProgressBar IsVisible="{Binding HasMeter}" Value="{Binding FractionPercent}"
                               Minimum="0" Maximum="100" Height="4" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
