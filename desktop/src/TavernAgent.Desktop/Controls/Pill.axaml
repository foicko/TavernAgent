<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Controls.Pill">
  <Border Name="PillSurface"
          CornerRadius="999"
          Padding="10,4"
          BorderThickness="1"
          Background="{DynamicResource GlassPillBrush}"
          BorderBrush="{DynamicResource GlassBorderBrush}">
    <ContentPresenter Content="{Binding $parent[controls:Pill].Body}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center" />
  </Border>
</UserControl>
