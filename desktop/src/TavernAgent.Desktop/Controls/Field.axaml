<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Controls.Field">
  <StackPanel Spacing="5">
    <TextBlock Text="{Binding $parent[controls:Field].Label}"
               IsVisible="{Binding $parent[controls:Field].Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               FontSize="{DynamicResource FsSm}"
               FontWeight="Medium"
               Foreground="{DynamicResource TextSecondaryBrush}" />
    <ContentPresenter Content="{Binding $parent[controls:Field].Body}" />
    <TextBlock Text="{Binding $parent[controls:Field].Hint}"
               IsVisible="{Binding $parent[controls:Field].Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               FontSize="{DynamicResource FsXs}"
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextDimBrush}" />
    <TextBlock Text="{Binding $parent[controls:Field].Error}"
               IsVisible="{Binding $parent[controls:Field].Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               FontSize="{DynamicResource FsXs}"
               TextWrapping="Wrap"
               Foreground="{DynamicResource DangerBrush}" />
  </StackPanel>
</UserControl>
