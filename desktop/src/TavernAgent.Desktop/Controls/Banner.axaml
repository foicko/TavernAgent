<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Controls.Banner">
  <Border Name="BannerSurface"
          CornerRadius="{DynamicResource RadiusMd}"
          BorderThickness="1"
          Padding="12,10"
          Background="{DynamicResource SubtleBrush}"
          BorderBrush="{DynamicResource BorderBrush}">
    <StackPanel Spacing="3">
      <TextBlock Text="{Binding $parent[controls:Banner].Title}"
                 IsVisible="{Binding $parent[controls:Banner].Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 FontSize="{DynamicResource FsSm}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
      <TextBlock Text="{Binding $parent[controls:Banner].Message}"
                 IsVisible="{Binding $parent[controls:Banner].Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 FontSize="{DynamicResource FsSm}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
      <ContentPresenter Content="{Binding $parent[controls:Banner].Body}" Margin="0,4,0,0" />
    </StackPanel>
  </Border>
</UserControl>
