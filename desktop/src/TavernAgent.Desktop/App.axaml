<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:TavernAgent.Desktop"
             x:Class="TavernAgent.Desktop.App"
             RequestedThemeVariant="Default">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://TavernAgent.Desktop/Styles/DesignTokens.axaml" />
        <ResourceInclude Source="avares://TavernAgent.Desktop/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <!-- Motion.axaml is loaded by MotionPreference so reduced-motion can omit it. -->
    <StyleInclude Source="avares://TavernAgent.Desktop/Styles/Surfaces.axaml" />
    <StyleInclude Source="avares://TavernAgent.Desktop/Styles/Controls.axaml" />
    <StyleInclude Source="avares://TavernAgent.Desktop/Styles/Stage.axaml" />
    <StyleInclude Source="avares://TavernAgent.Desktop/Styles/Rails.axaml" />
    <StyleInclude Source="avares://TavernAgent.Desktop/Styles/App.axaml" />
  </Application.Styles>
</Application>
