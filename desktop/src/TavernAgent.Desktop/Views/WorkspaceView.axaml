<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TavernAgent.Desktop.ViewModels"
             xmlns:c="using:TavernAgent.Desktop.Controls"
             xmlns:views="using:TavernAgent.Desktop.Views"
             xmlns:left="using:TavernAgent.Desktop.Views.Left"
             xmlns:right="using:TavernAgent.Desktop.Views.Right"
             xmlns:modals="using:TavernAgent.Desktop.Views.Modals"
             xmlns:settings="using:TavernAgent.Desktop.Views.Modals.Settings"
             xmlns:stageviews="using:TavernAgent.Desktop.Views.Stage"
             x:Class="TavernAgent.Desktop.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel">
  <Panel>

    <!-- Inline three-column grid: header on top, left rail / stage / right rail below. -->
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*,Auto">

      <views:TopHeaderView Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" />

      <Border Grid.Row="1" Grid.Column="0"
              Name="LeftRailSlot"
              Width="{Binding LeftRailWidth}"
              IsVisible="{Binding ShowLeftRail}"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,1,0"
              ClipToBounds="True">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Width" Duration="0:0:0.24" Easing="0.23,1,0.32,1" />
          </Transitions>
        </Border.Transitions>
        <Panel>
          <Panel IsVisible="{Binding ShowIconDock}">
            <left:IconRailView DataContext="{Binding LeftRail}" />
          </Panel>
          <Panel IsVisible="{Binding ShowLeftPanel}">
            <left:LeftRailView DataContext="{Binding LeftRail}" />
          </Panel>
        </Panel>
      </Border>

      <Panel Grid.Row="1" Grid.Column="1">
        <ContentControl Content="{Binding Stage}" />

        <!-- Recall pill for the collapsed right rail (flat, stage top-right). -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,12,12,0"
                IsVisible="{Binding ShowRightRailRecall}">
          <Button Classes="ui-btn sm quiet"
                  Command="{Binding ToggleRightRailCommand}"
                  ToolTip.Tip="展开角色档案 (Ctrl+])">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="icon" Data="{StaticResource IconUser}" Width="14" Height="14" />
              <Path Classes="icon" Data="{StaticResource IconChevronLeft}" Width="13" Height="13" />
            </StackPanel>
          </Button>
        </Border>
      </Panel>

      <Border Grid.Row="1" Grid.Column="2"
              Width="{Binding RightRailWidth}"
              IsVisible="{Binding ShowRightRail}"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1,0,0,0"
              ClipToBounds="True">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Width" Duration="0:0:0.24" Easing="0.23,1,0.32,1" />
          </Transitions>
        </Border.Transitions>
        <ContentControl Content="{Binding RightRail}" />
      </Border>
    </Grid>

    <!-- Story map modal -->
    <left:StoryMapModal DataContext="{Binding LeftRail.StoryMap}" />

    <!-- Full-body tachie lightbox -->
    <right:FullTachieModal DataContext="{Binding RightRail}" />

    <!-- Rail detail modals -->
    <modals:DossierModalView DataContext="{Binding Dossier}" />
    <modals:PromisesModalView DataContext="{Binding Promises}" />
    <modals:MemoryModalView DataContext="{Binding MemoryModal}" />
    <settings:SettingsModalView DataContext="{Binding SettingsModal}" />
    <modals:CharacterImportModalView DataContext="{Binding CharacterImport}" />
    <modals:WorldbookModalView DataContext="{Binding Worldbook}" />

    <!-- Command palette (Ctrl+K) -->
    <views:CommandPaletteView DataContext="{Binding Palette}" />

    <!-- Turn illustration modal + lightbox -->
    <modals:IllustrationModalView DataContext="{Binding Stage.Illustration}" />

    <!-- Director workspace -->
    <stageviews:DirectorWorkspaceView DataContext="{Binding Stage.Director}" />

    <!-- Turn illustration lightbox -->
    <Button IsVisible="{Binding Stage.LightboxOpen}"
            Command="{Binding Stage.CloseLightboxCommand}"
            Background="{DynamicResource ScrimBrush}"
            BorderThickness="0"
            Padding="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            ToolTip.Tip="点击任意处关闭">
      <Image Source="{Binding Stage.LightboxImage}" Stretch="Uniform" Margin="56" />
    </Button>

    <!-- Quiet toast (raised above the composer island so it never covers the input) -->
    <Border HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,168"
            MaxWidth="560"
            CornerRadius="{DynamicResource RadiusFull}"
            Padding="16,8"
            Background="{DynamicResource ElevatedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            BoxShadow="{DynamicResource ShadowFloat}"
            Classes="anim-rise-in-bottom"
            IsVisible="{Binding HasToast}"
            IsHitTestVisible="False">
      <TextBlock Text="{Binding ToastMessage}"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 FontSize="{DynamicResource FsSm}"
                 Foreground="{DynamicResource TextPrimaryBrush}" />
    </Border>
  </Panel>
</UserControl>
