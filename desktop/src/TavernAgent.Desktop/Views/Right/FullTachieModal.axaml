<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TavernAgent.Desktop.ViewModels.Right"
             xmlns:c="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Views.Right.FullTachieModal"
             x:DataType="vm:RightRailViewModel">
  <c:Modal IsOpen="{Binding IsFullTachieOpen}" CloseCommand="{Binding CloseFullTachieCommand}" Title="全身立绘" DialogWidth="980">
    <c:Modal.Body>
      <Grid ColumnDefinitions="320,*" ColumnSpacing="16" Height="520">
        <Border Grid.Column="0" CornerRadius="{DynamicResource RadiusLg}" ClipToBounds="True"
                Background="{DynamicResource SubtleBrush}">
          <Panel>
            <TextBlock Text="{Binding TachieMonogram}" FontSize="90" Opacity="0.35"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasTachie}" />
            <Image Source="{Binding Tachie}" Stretch="UniformToFill" VerticalAlignment="Top" IsVisible="{Binding HasTachie}" />
          </Panel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding Character.ShortName}" Classes="display" FontSize="20" />
            <TextBlock Text="{Binding Character.Name}" FontSize="{DynamicResource FsSm}"
                       Foreground="{DynamicResource TextDimBrush}" />
            <TextBlock Text="{Binding Character.Role}" TextWrapping="Wrap" FontSize="{DynamicResource FsSm}"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Classes="chip"><TextBlock Text="{Binding Character.StateBadge}" FontSize="10" /></Border>
              <Border Classes="chip"><TextBlock Text="{Binding Character.AllianceBadge}" FontSize="10" /></Border>
              <Border Classes="chip"><TextBlock Text="{Binding Character.VoiceBadge}" FontSize="10" /></Border>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Tags}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Classes="chip" Margin="0,0,4,4"><TextBlock Text="{Binding, StringFormat=#{0}}" FontSize="10" /></Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Character.ModalDesc}" TextWrapping="Wrap" Classes="narrative" FontSize="{DynamicResource FsSm}" />
            <TextBlock Text="{Binding Character.Scenario}" TextWrapping="Wrap" Classes="narrative" FontSize="{DynamicResource FsSm}"
                       IsVisible="{Binding Character.Scenario, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </c:Modal.Body>
  </c:Modal>
</UserControl>
