<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TavernAgent.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="TavernAgent.Desktop.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="TavernAgent"
        Width="1440" Height="900"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource WindowBackgroundBrush}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+K" Command="{Binding Workspace.TogglePaletteCommand}" />
    <KeyBinding Gesture="Ctrl+OemOpenBrackets" Command="{Binding Workspace.ToggleLeftRailCommand}" />
    <KeyBinding Gesture="Ctrl+OemCloseBrackets" Command="{Binding Workspace.ToggleRightRailCommand}" />
  </Window.KeyBindings>

  <Panel>
    <Border Name="BootOverlay" ClipToBounds="True" Background="{DynamicResource AppBaseBrush}"
            PointerPressed="OnBootOverlayPointerPressed">
      <Grid RowDefinitions="Auto,*">
        <!-- Top bar with caption buttons for boot screen -->
        <Border Grid.Row="0" Height="{DynamicResource HeaderHeightPx}" Padding="14,0,8,0">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
              <Border Width="8" Height="8" CornerRadius="999" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
              <TextBlock Text="TAVERN AGENT" Classes="display" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <Button Classes="caption-btn" Click="OnMinimizeClicked" ToolTip.Tip="最小化">
                <Path Data="{StaticResource IconWindowMinimize}" />
              </Button>
              <Button Classes="caption-btn close-btn" Click="OnCloseClicked" ToolTip.Tip="关闭">
                <Path Data="{StaticResource IconClose}" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto,*" ColumnDefinitions="*,Auto,*" MaxWidth="560" Margin="24">
          <StackPanel Grid.Row="1" Grid.Column="1" Spacing="16" HorizontalAlignment="Center">
            <TextBlock Text="TavernAgent"
                       FontSize="28"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding StatusText}"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ProgressBar Name="BootProgress"
                         IsIndeterminate="True"
                         Width="220"
                         Height="4"
                         Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="{Binding ErrorText}"
                       TextWrapping="Wrap"
                       MaxWidth="520"
                       IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="12" />
            <ScrollViewer Name="BootLogTail"
                          MaxWidth="520"
                          MaxHeight="220"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}">
              <SelectableTextBlock Text="{Binding LogTail}"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas,Menlo,monospace"
                                   FontSize="11"
                                   Opacity="0.75"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
            </ScrollViewer>
            <Button Content="重试"
                    HorizontalAlignment="Center"
                    Command="{Binding RetryCommand}"
                    IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <ContentControl Name="MainContent"
                    IsVisible="False"
                    Content="{Binding Workspace}" />
  </Panel>
</Window>
