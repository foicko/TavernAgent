<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TavernAgent.Desktop.ViewModels"
             xmlns:c="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Views.TopHeaderView"
             x:DataType="vm:WorkspaceViewModel">
  <Border Name="HeaderBorder"
          Background="{DynamicResource WindowBackgroundBrush}"
          BorderBrush="{DynamicResource BorderSubtleBrush}"
          BorderThickness="0,0,0,1"
          Padding="14,0"
          Height="{DynamicResource HeaderHeightPx}"
          PointerPressed="OnHeaderPointerPressed">
    <Grid ColumnDefinitions="*,Auto,*">

      <!-- Brand + breadcrumb -->
      <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*" VerticalAlignment="Center" Margin="0,0,12,0">
        <Border Grid.Column="0" Width="8" Height="8" CornerRadius="999" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Grid.Column="1" Text="TAVERN AGENT"
                   Classes="display"
                   FontSize="13"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
        <Border Grid.Column="2" Width="1" Height="14" Margin="0,0,10,0"
                Background="{DynamicResource BorderSubtleBrush}"
                IsVisible="{Binding HasStory}" />
        <Path Grid.Column="3" Classes="icon" Data="{StaticResource IconBook}" Width="13" Height="13"
              Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="{Binding HasStory}" />
        <TextBlock Grid.Column="4" Text="{Binding BreadcrumbTitle}"
                   FontSize="{DynamicResource FsSm}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"
                   IsVisible="{Binding HasStory}"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </Grid>

      <!-- View mode segmented control -->
      <Border Grid.Column="1"
              Classes="surface-inset"
              CornerRadius="{DynamicResource RadiusFull}"
              Padding="3"
              VerticalAlignment="Center"
              Margin="12,0">
        <StackPanel Orientation="Horizontal" Spacing="3">
          <Button Classes="seg soft-brush" Classes.active="{Binding IsStudioMode}"
                  Command="{Binding EnterStudioCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="icon" Data="{StaticResource IconCompass}" Width="12" Height="12" />
              <TextBlock Text="工作台" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="seg soft-brush" Classes.active="{Binding IsReadingMode}"
                  Command="{Binding EnterReadingCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="icon" Data="{StaticResource IconBook}" Width="12" Height="12" />
              <TextBlock Text="纯净编年" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- Actions -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                  HorizontalAlignment="Right">
        <Button Classes="header-pill soft-brush" Command="{Binding TogglePaletteCommand}" ToolTip.Tip="命令面板 (Ctrl+K)">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="icon" Data="{StaticResource IconCommand}" Width="11" Height="11" />
            <c:Kbd Text="Ctrl K" />
          </StackPanel>
        </Button>

        <Button Classes="model-pill soft-brush" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="模型与连接">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                     Fill="{DynamicResource SuccessBrush}"
                     IsVisible="{Binding HasActiveModel}" />
            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                     Fill="{DynamicResource TextDimBrush}"
                     IsVisible="{Binding !HasActiveModel}" />
            <TextBlock Text="{Binding ActiveModelName}"
                       FontSize="{DynamicResource FsSm}"
                       MaxWidth="170"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Classes="caption-btn" Width="28" Height="28" CornerRadius="999"
                Command="{Binding ToggleThemeCommand}"
                ToolTip.Tip="{Binding ThemeLabel}">
          <Panel>
            <Path Classes="icon" Data="{StaticResource IconSun}" Width="14" Height="14"
                  IsVisible="{Binding IsDarkTheme}" />
            <Path Classes="icon" Data="{StaticResource IconMoon}" Width="14" Height="14"
                  IsVisible="{Binding !IsDarkTheme}" />
          </Panel>
        </Button>

        <!-- Window Caption Controls (Windows / Linux) -->
        <Border Name="CaptionDivider" Width="1" Height="14" Margin="4,0,2,0"
                Background="{DynamicResource BorderSubtleBrush}" Opacity="0.6" />

        <StackPanel Name="CaptionButtonsStack" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Name="BtnMinimize" Classes="caption-btn" Click="OnMinimizeClicked" ToolTip.Tip="最小化"
                  AutomationProperties.Name="最小化">
            <Path Data="{StaticResource IconWindowMinimize}" />
          </Button>

          <Button Name="BtnMaximize" Classes="caption-btn" Click="OnMaximizeClicked" ToolTip.Tip="最大化"
                  AutomationProperties.Name="最大化 / 还原">
            <Panel>
              <Path Name="IconMaximize" Data="{StaticResource IconWindowMaximize}" />
              <Path Name="IconRestore" Data="{StaticResource IconWindowRestore}" IsVisible="False" />
            </Panel>
          </Button>

          <Button Name="BtnClose" Classes="caption-btn close-btn" Click="OnCloseClicked" ToolTip.Tip="关闭"
                  AutomationProperties.Name="关闭">
            <Path Data="{StaticResource IconClose}" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
