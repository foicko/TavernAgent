<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TavernAgent.Desktop.ViewModels.Stage"
             x:Class="TavernAgent.Desktop.Views.Stage.ComposerView"
             x:DataType="vm:ComposerViewModel">
  <Grid MaxWidth="{DynamicResource StageComposerWidth}" HorizontalAlignment="Stretch">
    <!-- Fade scrim: narrative dissolves into the background as it passes behind the floating island. -->
    <Border IsHitTestVisible="False"
            Background="{DynamicResource ComposerScrimBrush}" />
    <Border Classes="composer-island anim-rise-in-bottom"
            CornerRadius="{DynamicResource RadiusLg}"
            Margin="24,12,24,16"
            Padding="16,12">
      <StackPanel Spacing="8">

        <!-- Note row (仅在展开注记时显示) -->
        <Border IsVisible="{Binding IsNoteOpen}"
                Classes="surface-inset"
                CornerRadius="{DynamicResource RadiusMd}"
                Padding="8,4">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" Margin="4,0,8,0" VerticalAlignment="Center">
              <Path Classes="icon" Data="{StaticResource IconNote}" Width="12" Height="12"
                    Stroke="{DynamicResource TextDimBrush}" />
              <TextBlock Text="本轮注记" FontSize="{DynamicResource FsXs}"
                         Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBox Grid.Column="1" Text="{Binding Note}"
                     Background="Transparent" BorderThickness="0"
                     FontSize="{DynamicResource FsSm}"
                     PlaceholderText="对本轮演绎的要求（非台词，不污染正文）：放慢节奏、多写环境…" />
            <Button Grid.Column="2" Classes="icon-btn-compact" Command="{Binding ToggleNoteCommand}"
                    ToolTip.Tip="收起注记">
              <Path Classes="icon xs" Data="{StaticResource IconClose}" />
            </Button>
          </Grid>
        </Border>

        <!-- Main text input area -->
        <TextBox Name="InputBox"
                 Classes="composer-input"
                 Text="{Binding Text, Mode=TwoWay}"
                 KeyDown="OnInputKeyDown"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="56"
                 MaxHeight="200"
                 PlaceholderText="输入你的行动或对白… (Enter 发送 · Shift+Enter 换行)" />

        <!-- Streamlined control deck (一体化操作栏 - Antigravity 风格) -->
        <Grid ColumnDefinitions="*,Auto" Height="32">
          <!-- Left side: [+] Action Menu, Active State Badges, and Model selector -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <!-- 1. Unified [+] Action Menu Button -->
            <Button Name="ActionMenuButton"
                    Classes="action-plus-btn"
                    ToolTip.Tip="辅助创作与推演工具（导演模式、注记、排版标记）">
              <Button.Flyout>
                <Flyout Placement="TopEdgeAlignedLeft">
                  <Border Width="260" Classes="surface-elevated"
                          CornerRadius="{DynamicResource RadiusLg}"
                          BorderBrush="{DynamicResource BorderMidBrush}"
                          BorderThickness="1"
                          BoxShadow="{DynamicResource Elevation3}"
                          Padding="10">
                    <StackPanel Spacing="6">
                      <!-- Section 1: Creative tools -->
                      <TextBlock Text="创作推演工具" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextDimBrush}" Margin="4,2,0,2" />

                      <!-- Director Mode -->
                      <Button Classes="menu-action-item"
                              Command="{Binding OpenDirectorCommand}"
                              Click="OnActionItemClick"
                              ToolTip.Tip="讨论大纲并安排后续剧情">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Path Classes="icon" Data="{StaticResource IconFilm}" Width="14" Height="14"
                                  Stroke="{DynamicResource TextPrimaryBrush}" />
                            <StackPanel Spacing="1">
                              <TextBlock Text="导演模式" FontSize="{DynamicResource FsSm}" FontWeight="SemiBold" />
                              <TextBlock Text="讨论大纲与安排剧情" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                            </StackPanel>
                          </StackPanel>
                          <Border Grid.Column="2" Classes="state-pill" Background="{DynamicResource SuccessSoftBrush}"
                                  BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1"
                                  Padding="6,2" VerticalAlignment="Center"
                                  IsVisible="{Binding Director.IsActive}">
                            <TextBlock Text="推进中" FontSize="10" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
                          </Border>
                        </Grid>
                      </Button>

                      <!-- Turn Note -->
                      <Button Classes="menu-action-item"
                              Command="{Binding ToggleNoteCommand}"
                              Click="OnActionItemClick"
                              ToolTip.Tip="对本轮演绎写下非正文提示">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Path Classes="icon" Data="{StaticResource IconNote}" Width="14" Height="14"
                                  Stroke="{DynamicResource TextPrimaryBrush}" />
                            <StackPanel Spacing="1">
                              <TextBlock Text="本轮注记" FontSize="{DynamicResource FsSm}" FontWeight="SemiBold" />
                              <TextBlock Text="非正文演绎提示" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                            </StackPanel>
                          </StackPanel>
                          <Border Grid.Column="2" Classes="state-pill" Background="{DynamicResource AccentSubtleBrush}"
                                  BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                  Padding="6,2" VerticalAlignment="Center"
                                  IsVisible="{Binding HasNote}">
                            <TextBlock Text="已设置" FontSize="10" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                          </Border>
                        </Grid>
                      </Button>

                      <!-- Section 2: Formatting Macros -->
                      <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="2,4" />
                      <TextBlock Text="排版标记" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextDimBrush}" Margin="4,2,0,2" />
                      <ItemsControl ItemsSource="{Binding Macros}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:MacroPill">
                            <Button Classes="macro-pill"
                                    ToolTip.Tip="{Binding Label}"
                                    Click="OnMacroClick">
                              <TextBlock Text="{Binding Label}" FontSize="11" />
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </Flyout>
              </Button.Flyout>
              <Path Classes="icon sm" Data="{StaticResource IconPlus}" Width="11" Height="11"
                    Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.35"
                    StrokeLineCap="Round" />
            </Button>

            <!-- 2. Model quick switch ComboBox -->
            <ComboBox Classes="composer-pill"
                      IsVisible="{Binding HasModels}"
                      ItemsSource="{Binding Models}"
                      SelectedItem="{Binding SelectedModel}"
                      Height="28"
                      MinWidth="100"
                      MaxWidth="150"
                      FontSize="{DynamicResource FsXs}"
                      VerticalContentAlignment="Center"
                      ToolTip.Tip="临时切换本轮所用的 AI 模型（全局配置请点击右上角）">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="vm:ModelQuickItem">
                  <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FsXs}"
                             TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- 3. Active Mode Badges (Pop up only when active) -->
            <!-- Director badge -->
            <Button Classes="active-mode-pill"
                    Command="{Binding OpenDirectorCommand}"
                    IsVisible="{Binding IsDirectorModeBadgeVisible}"
                    ToolTip.Tip="导演模式推进中，点击打开大纲抽屉">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Ellipse Width="5" Height="5" Fill="{DynamicResource SuccessBrush}" />
                <TextBlock Text="导演模式" FontSize="{DynamicResource FsXs}" FontWeight="Medium"
                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Note badge -->
            <Button Classes="active-mode-pill"
                    Command="{Binding ToggleNoteCommand}"
                    IsVisible="{Binding HasNote}"
                    ToolTip.Tip="已设置本轮注记，点击展开编辑">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Classes="icon sm" Data="{StaticResource IconNote}" Width="11" Height="11"
                      Stroke="{DynamicResource AccentBrush}" />
                <TextBlock Text="已设注记" FontSize="{DynamicResource FsXs}" FontWeight="Medium"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Right side: Context token gauge, Reasoning effort, Action circular buttons -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
            <!-- Context metrics donut pill button -->
            <Button Classes="composer-pill-btn" Height="28"
                    ToolTip.Tip="上下文窗口占用比例（点击查看令牌预算与拆解）">
              <Button.Flyout>
                <Flyout Placement="Top">
                  <Border DataContext="{Binding Context}" Width="272" Classes="surface-elevated"
                          CornerRadius="{DynamicResource RadiusLg}"
                          BorderBrush="{DynamicResource BorderMidBrush}"
                          BorderThickness="1"
                          BoxShadow="{DynamicResource Elevation3}"
                          Padding="14">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="上下文占用" FontWeight="Medium"
                                   FontSize="{DynamicResource FsXs}" Foreground="{DynamicResource TextDimBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding PercentageText}"
                                   FontSize="{DynamicResource FsXs}" FontWeight="Medium" />
                      </Grid>
                      <TextBlock Text="{Binding ModelName, StringFormat=模型：{0}}" FontSize="{DynamicResource FsXs}"
                                 Foreground="{DynamicResource TextDimBrush}" />
                      <ProgressBar Value="{Binding Percentage}" Minimum="0" Maximum="100" />
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding UsedFormatted}" FontSize="{DynamicResource FsXs}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding LimitFormatted, StringFormat=上限 {0}}" FontSize="{DynamicResource FsXs}"
                                   Foreground="{DynamicResource TextDimBrush}" />
                        <TextBlock Text="{Binding CacheLabel, StringFormat=前缀缓存命中 {0}}" FontSize="{DynamicResource FsXs}"
                                   Foreground="{DynamicResource TextDimBrush}" />
                      </StackPanel>
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding SystemLabel, StringFormat=系统人设　{0}}" FontSize="{DynamicResource FsXs}" />
                        <TextBlock Text="{Binding MemoryLabel, StringFormat=记忆世界　{0}}" FontSize="{DynamicResource FsXs}" />
                        <TextBlock Text="{Binding HistoryLabel, StringFormat=对话历史　{0}}" FontSize="{DynamicResource FsXs}" />
                        <TextBlock Text="{Binding DraftLabel, StringFormat=当前草稿　{0}}" FontSize="{DynamicResource FsXs}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </Flyout>
              </Button.Flyout>
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Panel Width="14" Height="14" VerticalAlignment="Center">
                  <Ellipse Width="14" Height="14" Stroke="{DynamicResource MeterTrackBrush}" StrokeThickness="2" />
                  <Arc Width="14" Height="14" StartAngle="-90"
                       SweepAngle="{Binding Context.SweepAngle}"
                       Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2" />
                </Panel>
                <TextBlock Text="{Binding Context.PercentageText}" FontSize="11"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Reasoning effort dropdown -->
            <ComboBox Classes="composer-pill"
                      ItemsSource="{Binding Efforts}"
                      SelectedItem="{Binding SelectedEffortItem}"
                      Height="28"
                      MinWidth="64"
                      FontSize="{DynamicResource FsXs}"
                      VerticalContentAlignment="Center"
                      ToolTip.Tip="思考强度">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="vm:EffortItem">
                  <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsXs}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Cancel Button (when generating): circular stop button -->
            <Button Classes="send-circle-btn danger" IsVisible="{Binding CanCancel}"
                    Command="{Binding CancelCommand}"
                    ToolTip.Tip="停止生成">
              <Path Classes="icon" Data="{StaticResource IconStop}" Width="12" Height="12"
                    Stroke="{DynamicResource AccentContrastBrush}" StrokeThickness="2" />
            </Button>

            <!-- Continue Button (when truncated) -->
            <Button Classes="send-circle-btn primary" IsVisible="{Binding CanContinue}"
                    Command="{Binding ContinueCommand}"
                    ToolTip.Tip="继续生成未完成内容">
              <Path Classes="icon" Data="{StaticResource IconPlay}" Width="12" Height="12"
                    Stroke="{DynamicResource AccentContrastBrush}" StrokeThickness="2" />
            </Button>

            <!-- Retry Button (when failed) -->
            <Button Classes="send-circle-btn quiet" IsVisible="{Binding CanRetry}"
                    Command="{Binding RetryCommand}"
                    ToolTip.Tip="重新尝试本轮生成">
              <Path Classes="icon" Data="{StaticResource IconRefresh}" Width="12" Height="12" />
            </Button>

            <!-- Send Button: modern circular button -->
            <Button Classes="send-circle-btn primary" IsVisible="{Binding ShowSendButton}"
                    Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}"
                    ToolTip.Tip="发送 (Enter)">
              <Path Classes="icon" Data="{StaticResource IconArrowUp}" Width="13" Height="13"
                    Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" />
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
