<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TavernAgent.Desktop.ViewModels.Stage"
             xmlns:c="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Views.Stage.DirectorWorkspaceView"
             x:DataType="vm:DirectorViewModel">
  <c:Modal IsOpen="{Binding IsOpen}" CloseCommand="{Binding CloseCommand}" Title="导演模式" DialogWidth="1160">
    <c:Modal.Body>
      <StackPanel Width="1080" Spacing="12">

        <TextBlock Text="与模型协商剧情大纲与阶段；草稿会自动保存，点「启用大纲」后从下一回合开始生效。"
                   TextWrapping="Wrap" FontSize="{DynamicResource FsXs}" Foreground="{DynamicResource TextDimBrush}" />

        <c:Banner Classes="warning" Message="历史快照为只读，请回到最新节点或先分叉后再编辑。" IsVisible="{Binding IsReadOnly}" />
        <c:Banner Classes="danger" Message="{Binding Error}" IsVisible="{Binding HasError}" />
        <c:Banner Classes="success" Message="{Binding Notice}" IsVisible="{Binding HasNotice}" />

        <!-- active plan summary -->
        <Border Classes="surface-inset" CornerRadius="{DynamicResource RadiusLg}" Padding="12" IsVisible="{Binding HasState}">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{Binding SummaryTitle}" FontSize="{DynamicResource FsSm}" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource FsXs}"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding ProgressText}" FontSize="{DynamicResource FsXs}"
                             Foreground="{DynamicResource TextDimBrush}" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Classes="ui-btn sm quiet" Command="{Binding PauseCommand}" IsVisible="{Binding IsActive}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path Classes="icon" Data="{StaticResource IconPause}" Width="12" Height="12" />
                    <TextBlock Text="暂停" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="ui-btn sm quiet" Command="{Binding ResumeCommand}" IsVisible="{Binding IsPaused}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path Classes="icon" Data="{StaticResource IconPlay}" Width="12" Height="12" />
                    <TextBlock Text="继续" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="ui-btn sm quiet" Command="{Binding CompleteBeatCommand}"
                        IsVisible="{Binding IsActive}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path Classes="icon" Data="{StaticResource IconCheck}" Width="12" Height="12" />
                    <TextBlock Text="完成本阶段" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="ui-btn sm ghost" Command="{Binding SkipBeatCommand}"
                        IsVisible="{Binding IsActive}" Content="跳过" />
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding CurrentBeatText}" FontSize="{DynamicResource FsXs}"
                       Foreground="{DynamicResource TextDimBrush}" />
            <TextBlock Text="{Binding Warning}" FontSize="{DynamicResource FsXs}"
                       Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding HasWarning}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- two columns -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Height="400">

          <!-- discussion -->
          <Border Grid.Column="0" Classes="surface-inset" CornerRadius="{DynamicResource RadiusLg}" Padding="12">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
              <TextBlock Grid.Row="0" Text="与导演协商" FontSize="{DynamicResource FsSm}" FontWeight="SemiBold" />
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                  <c:EmptyState IsVisible="{Binding !HasExchanges}" IconGeometry="{StaticResource IconFilm}" Title="还没有讨论"
                                Description="向导演提问，例如「下一幕该怎么推进？」它会给出建议大纲。" />
                  <ItemsControl ItemsSource="{Binding Exchanges}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DirectorExchangeViewModel">
                        <Border Classes="surface-inset" CornerRadius="{DynamicResource RadiusMd}" Padding="10" Margin="0,0,0,8">
                          <StackPanel Spacing="6">
                            <TextBlock Text="你" FontSize="10" Foreground="{DynamicResource TextDimBrush}" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="{DynamicResource FsSm}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Border Classes="state-pill"><TextBlock Text="{Binding StatusLabel}" FontSize="10" /></Border>
                              <Button Classes="ui-btn sm ghost" Content="载入此建议" IsVisible="{Binding HasCandidate}"
                                      CommandParameter="{Binding}"
                                      Command="{Binding $parent[ItemsControl].((vm:DirectorViewModel)DataContext).LoadCandidateCommand}" />
                              <Button Classes="ui-btn sm ghost" Content="重试" IsVisible="{Binding CanRetry}"
                                      CommandParameter="{Binding}"
                                      Command="{Binding $parent[ItemsControl].((vm:DirectorViewModel)DataContext).RetryExchangeCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Reply}" TextWrapping="Wrap" FontSize="{DynamicResource FsSm}"
                                       IsVisible="{Binding HasReply}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="{DynamicResource FsXs}"
                                       IsVisible="{Binding HasError}" Foreground="{DynamicResource DangerBrush}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
              <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Text="{Binding DiscussionText}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="64" MaxHeight="120" PlaceholderText="向导演提问或给出要求…" />
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                  <Button Classes="ui-btn primary" Command="{Binding SendCommand}" IsVisible="{Binding !Running}"
                          IsEnabled="{Binding CanDiscuss}" Content="发送" />
                  <Button Classes="ui-btn danger" Command="{Binding StopDiscussionCommand}" IsVisible="{Binding Running}"
                          Content="停止讨论" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <!-- editor -->
          <Border Grid.Column="1" Classes="surface-inset" CornerRadius="{DynamicResource RadiusLg}" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="10">
                <TextBlock Text="大纲编辑" FontSize="{DynamicResource FsSm}" FontWeight="SemiBold" />
                <c:Field Label="大纲标题">
                  <c:Field.Body><TextBox Text="{Binding Title}" PlaceholderText="例如：雨夜客栈的暗流" /></c:Field.Body>
                </c:Field>
                <c:Field Label="总体指导">
                  <c:Field.Body>
                    <TextBox Text="{Binding Guidance}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                             PlaceholderText="贯穿整条大纲的叙事要求…" />
                  </c:Field.Body>
                </c:Field>
                <c:Switch IsChecked="{Binding ReplaceAll}">
                  <c:Switch.Body><TextBlock Text="整体替换大纲（从第一阶段重来）" FontSize="{DynamicResource FsXs}" /></c:Switch.Body>
                </c:Switch>

                <ItemsControl ItemsSource="{Binding Beats}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DirectorBeatViewModel">
                      <Border Classes="surface-inset" CornerRadius="{DynamicResource RadiusMd}" Padding="10" Margin="0,0,0,8">
                        <StackPanel Spacing="6">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Number}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border Grid.Column="1" Classes="state-pill" HorizontalAlignment="Left"
                                    Classes.active="{Binding IsCurrent}">
                              <TextBlock Text="{Binding StatusLabel}" FontSize="10" />
                            </Border>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                              <Button Classes="ui-btn sm ghost" Padding="4,0" ToolTip.Tip="上移阶段"
                                      CommandParameter="{Binding}"
                                      Command="{Binding $parent[ItemsControl].((vm:DirectorViewModel)DataContext).MoveBeatUpCommand}">
                                <Path Classes="icon" Data="{StaticResource IconArrowUp}" Width="12" Height="12" />
                              </Button>
                              <Button Classes="ui-btn sm ghost" Padding="4,0" ToolTip.Tip="下移阶段"
                                      CommandParameter="{Binding}"
                                      Command="{Binding $parent[ItemsControl].((vm:DirectorViewModel)DataContext).MoveBeatDownCommand}">
                                <Path Classes="icon" Data="{StaticResource IconArrowDown}" Width="12" Height="12" />
                              </Button>
                              <Button Classes="ui-btn sm ghost" Padding="4,0" ToolTip.Tip="删除阶段"
                                      CommandParameter="{Binding}"
                                      Command="{Binding $parent[ItemsControl].((vm:DirectorViewModel)DataContext).DeleteBeatCommand}">
                                <Path Classes="icon danger" Data="{StaticResource IconTrash}" Width="12" Height="12" />
                              </Button>
                              <Button Classes="ui-btn sm ghost" Padding="4,0"
                                      IsVisible="{Binding IsSettled}"
                                      CommandParameter="{Binding}"
                                      Command="{Binding $parent[ItemsControl].((vm:DirectorViewModel)DataContext).RewindCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <Path Classes="icon" Data="{StaticResource IconUndo}" Width="12" Height="12" />
                                  <TextBlock Text="回退" VerticalAlignment="Center" />
                                </StackPanel>
                              </Button>
                            </StackPanel>
                          </Grid>
                          <TextBox Text="{Binding Title}" PlaceholderText="阶段名称" FontSize="{DynamicResource FsSm}" />
                          <TextBox Text="{Binding Instruction}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                                   PlaceholderText="剧情安排" FontSize="{DynamicResource FsSm}" />
                          <TextBox Text="{Binding CompletionCriteria}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"
                                   PlaceholderText="完成条件" FontSize="{DynamicResource FsXs}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Classes="ui-btn sm quiet" Command="{Binding AddBeatCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path Classes="icon" Data="{StaticResource IconPlus}" Width="12" Height="12" />
                    <TextBlock Text="添加阶段" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- footer -->
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding ActivateHint}" VerticalAlignment="Center"
                     FontSize="{DynamicResource FsXs}" Foreground="{DynamicResource TextDimBrush}" />
          <Button Grid.Column="1" Classes="ui-btn primary" Command="{Binding ActivateCommand}"
                  IsEnabled="{Binding CanActivate}" Content="{Binding ReplaceLabel}" />
        </Grid>

      </StackPanel>
    </c:Modal.Body>
  </c:Modal>
</UserControl>
