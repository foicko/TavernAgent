<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TavernAgent.Desktop.ViewModels.Stage"
             x:Class="TavernAgent.Desktop.Views.Stage.SceneBarView"
             x:DataType="vm:StageViewModel">
  <!-- 常驻场景标签：展示最近一次 [SCENE] 标记（服务端已归一化进 UIHints）。
       只做展示，不改世界状态。 -->
  <Border Classes="surface-inset" CornerRadius="{DynamicResource RadiusMd}" Margin="20,8,20,4" Padding="12,6"
          MaxWidth="{DynamicResource StageReadingWidth}" HorizontalAlignment="Center"
          BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
          IsVisible="{Binding HasActiveScene}">
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <Path Classes="icon" Data="{StaticResource IconCompass}" Width="13" Height="13"
            Stroke="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
      <TextBlock Text="场景" FontSize="{DynamicResource FsXs}"
                 Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
      <TextBlock Text="{Binding ActiveSceneTitle}" FontSize="{DynamicResource FsSm}"
                 Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
    </StackPanel>
  </Border>
</UserControl>
