<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TavernAgent.Desktop.ViewModels.Stage"
             x:Class="TavernAgent.Desktop.Views.Stage.SceneBarView"
             x:DataType="vm:StageViewModel">
  <Border Classes="surface" Margin="24,12,24,6" Padding="14,8"
          MaxWidth="820" HorizontalAlignment="Stretch">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Panel Width="38" Height="38">
          <Ellipse Fill="{DynamicResource AccentBrush}" />
          <TextBlock Text="{Binding CharMonogram}"
                     FontSize="15" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{DynamicResource AccentContrastBrush}" />
        </Panel>
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding CharShortName}" FontWeight="SemiBold"
                       FontSize="{DynamicResource FsMd}"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <Border Classes="chip"><TextBlock Text="{Binding CharStateBadge}" FontSize="{DynamicResource FsXs}" /></Border>
            <Border Classes="chip"><TextBlock Text="{Binding CharVoiceBadge}" FontSize="{DynamicResource FsXs}" /></Border>
          </StackPanel>
          <TextBlock Text="{Binding CharRole}" TextTrimming="CharacterEllipsis" MaxWidth="440"
                     FontSize="{DynamicResource FsXs}"
                     Foreground="{DynamicResource TextDimBrush}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="ui-btn sm quiet soft-brush" Command="{Binding RegenerateLatestCommand}"
                IsEnabled="{Binding !Busy}" Content="重新讲述此轮" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
