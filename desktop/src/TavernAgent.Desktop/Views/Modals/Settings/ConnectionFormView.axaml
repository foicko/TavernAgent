<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:TavernAgent.Desktop.ViewModels.Modals.Settings"
             xmlns:c="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Views.Modals.Settings.ConnectionFormView"
             x:DataType="settings:ConnectionFormViewModel">
  <StackPanel Spacing="12">

    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="{DynamicResource FsMd}"
                 FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Button Grid.Column="1" Classes="ui-btn sm ghost" Command="{Binding CancelCommand}" Content="返回列表" />
    </Grid>

    <!-- provider presets -->
    <StackPanel Spacing="6">
      <TextBlock Text="服务商预设" FontSize="{DynamicResource FsXs}" Foreground="{DynamicResource TextDimBrush}" />
      <ItemsControl ItemsSource="{Binding Presets}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="settings:ProviderPreset">
            <Button Classes="ui-btn sm quiet" Margin="0,0,6,6" Content="{Binding Label}"
                    CommandParameter="{Binding}"
                    Command="{Binding $parent[ItemsControl].((settings:ConnectionFormViewModel)DataContext).ApplyPresetCommand}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding PresetKeyHint}" IsVisible="{Binding HasPresetKeyHint}"
                 FontSize="{DynamicResource FsXs}" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" />
    </StackPanel>

    <c:Banner Classes="danger" Message="{Binding AlertText}" IsVisible="{Binding HasAlert}" />
    <c:Banner Classes="danger" Message="{Binding ProbeText}" IsVisible="{Binding HasProbe}" />

    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
      <c:Field Grid.Column="0" Label="模型名称" Hint="例如 deepseek-chat" Error="{Binding ModelError}">
        <c:Field.Body>
          <TextBox Text="{Binding Model}" PlaceholderText="deepseek-chat" />
        </c:Field.Body>
      </c:Field>
      <c:Field Grid.Column="1" Label="接口地址" Hint="填到版本根即可，程序会自动补全路径" Error="{Binding BaseUrlError}">
        <c:Field.Body>
          <TextBox Text="{Binding BaseUrl}" PlaceholderText="https://api.deepseek.com" />
        </c:Field.Body>
      </c:Field>
    </Grid>

    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
      <c:Field Grid.Column="0" Label="API Key" Hint="{Binding KeyHint}" Error="{Binding ApiKeyError}">
        <c:Field.Body>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding ApiKey}" PasswordChar="●"
                     RevealPassword="{Binding ShowKey}" PlaceholderText="留空 = 保持不变" />
            <Button Grid.Column="1" Classes="icon" Margin="6,0,0,0" Command="{Binding ToggleKeyCommand}"
                    ToolTip.Tip="显示 / 隐藏密钥">
              <Path Classes="icon" Data="{StaticResource IconEye}" Width="15" Height="15" />
            </Button>
          </Grid>
        </c:Field.Body>
      </c:Field>
      <c:Field Grid.Column="1" Label="名称" Error="{Binding NameError}">
        <c:Field.Body>
          <TextBox Text="{Binding Name}" PlaceholderText="给这条连接起个名字" />
        </c:Field.Body>
      </c:Field>
    </Grid>

    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
      <c:Field Grid.Column="0" Label="协议">
        <c:Field.Body>
          <ComboBox ItemsSource="{Binding ProtocolOptions}" SelectedItem="{Binding SelectedProtocol}" HorizontalAlignment="Stretch" />
        </c:Field.Body>
      </c:Field>
      <c:Field Grid.Column="1" Label="思考强度">
        <c:Field.Body>
          <ComboBox ItemsSource="{Binding EffortOptions}" SelectedItem="{Binding SelectedEffort}" HorizontalAlignment="Stretch" />
        </c:Field.Body>
      </c:Field>
    </Grid>

    <TextBlock Text="生成参数" FontSize="{DynamicResource FsXs}" Foreground="{DynamicResource TextDimBrush}" />
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
      <c:Field Grid.Column="0" Label="上下文窗口" Error="{Binding ContextWindowError}">
        <c:Field.Body>
          <TextBox Text="{Binding ContextWindow}" PlaceholderText="131072" />
        </c:Field.Body>
      </c:Field>
      <c:Field Grid.Column="1" Label="最大输出" Error="{Binding MaxTokensError}">
        <c:Field.Body>
          <TextBox Text="{Binding MaxTokens}" PlaceholderText="4096" />
        </c:Field.Body>
      </c:Field>
      <c:Field Grid.Column="2" Label="温度" Error="{Binding TemperatureError}">
        <c:Field.Body>
          <TextBox Text="{Binding Temperature}" PlaceholderText="0.8" />
        </c:Field.Body>
      </c:Field>
    </Grid>
    <TextBlock Text="{Binding InputBudgetText}" FontSize="{DynamicResource FsXs}"
               Foreground="{DynamicResource TextSecondaryBrush}" />

    <c:Banner Classes="info" Message="{Binding UsedByText}" IsVisible="{Binding HasUsedBy}" />

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Classes="ui-btn quiet" Command="{Binding TestCommand}" IsEnabled="{Binding !Probing}" Content="测试连接" />
      <Button Classes="ui-btn primary" Command="{Binding SaveCommand}" Content="{Binding SaveLabel}" />
      <TextBlock Text="" />
      <c:Pill Classes="accent" IsVisible="{Binding IsUsed}"><TextBlock Text="使用中" /></c:Pill>
      <Button Classes="ui-btn danger" HorizontalAlignment="Right"
              Command="{Binding AskDeleteCommand}" Content="删除连接"
              IsVisible="{Binding !ConfirmDelete}" IsEnabled="{Binding !IsUsed}" />
      <Button Classes="ui-btn danger" HorizontalAlignment="Right"
              Command="{Binding DeleteCommand}" Content="确认删除"
              IsVisible="{Binding ConfirmDelete}" IsEnabled="{Binding !IsUsed}" />
      <Button Classes="ui-btn ghost" Command="{Binding CancelDeleteCommand}" Content="取消"
              IsVisible="{Binding ConfirmDelete}" />
    </StackPanel>

  </StackPanel>
</UserControl>
