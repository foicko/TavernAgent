<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TavernAgent.Desktop.ViewModels"
             xmlns:settings="using:TavernAgent.Desktop.ViewModels.Modals.Settings"
             xmlns:c="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Views.Modals.Settings.SettingsModalView"
             x:DataType="settings:SettingsModalViewModel">
  <c:Modal IsOpen="{Binding IsOpen}" CloseCommand="{Binding CloseCommand}" Title="设置" DialogWidth="1080">
    <c:Modal.Body>
      <Grid Width="1000" Height="560" RowDefinitions="Auto,Auto,*" RowSpacing="12">

        <ItemsControl Grid.Row="0" ItemsSource="{Binding Tabs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="settings:SettingsTabItem">
              <Button Classes="ui-btn sm quiet" Classes.active="{Binding IsActive}"
                      Command="{Binding SelectCommand}" CommandParameter="{Binding}" Content="{Binding Title}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="1" Text="{Binding ActiveDescription}" TextWrapping="Wrap"
                   FontSize="{DynamicResource FsXs}" Foreground="{DynamicResource TextDimBrush}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ContentControl Content="{Binding Page}" Margin="0,0,6,0" />
        </ScrollViewer>
      </Grid>
    </c:Modal.Body>
  </c:Modal>
</UserControl>
