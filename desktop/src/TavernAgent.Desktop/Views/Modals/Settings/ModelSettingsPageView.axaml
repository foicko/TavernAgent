<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:TavernAgent.Desktop.ViewModels.Modals.Settings"
             xmlns:c="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Views.Modals.Settings.ModelSettingsPageView"
             x:DataType="settings:ModelSettingsPageViewModel">
  <StackPanel Spacing="12">

    <c:Section Title="模型槽位与分工 (Slots)">
      <c:Section.Body>
        <StackPanel Spacing="6">
          <ItemsControl ItemsSource="{Binding SlotPickers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="settings:SlotPickerViewModel">
                <Grid ColumnDefinitions="180,*,Auto" Margin="0,0,0,10">
                  <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsSm}" FontWeight="Medium" />
                    <TextBlock Text="{Binding Hint}" FontSize="{DynamicResource FsXs}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextDimBrush}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                              IsEnabled="{Binding IsPickerEnabled}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource FsXs}"
                               Foreground="{DynamicResource TextDimBrush}" />
                  </StackPanel>
                  <c:Switch Grid.Column="2" Margin="12,0,0,0" IsVisible="{Binding IsReflection}"
                            IsChecked="{Binding Enabled}">
                    <c:Switch.Body>
                      <TextBlock Text="启用后台记忆" FontSize="{DynamicResource FsXs}" />
                    </c:Switch.Body>
                  </c:Switch>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <c:Banner Classes="danger" Message="{Binding RoleError}" IsVisible="{Binding HasRoleError}" />
        </StackPanel>
      </c:Section.Body>
    </c:Section>

    <c:Section Title="服务商连接 (Connections)">
      <c:Section.Body>
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsEditing}">
            <TextBlock Grid.Column="0" Text="模型连接" FontSize="{DynamicResource FsSm}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ui-btn sm quiet" Command="{Binding NewConnectionCommand}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Classes="icon" Data="{StaticResource IconPlus}" Width="12" Height="12" />
                <TextBlock Text="新建连接" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <c:Banner Classes="success" Message="{Binding Notice}" IsVisible="{Binding HasNotice}" />

          <c:EmptyState IsVisible="{Binding ShowEmpty}" IconGeometry="{StaticResource IconPlug}" Title="还没有模型连接"
                        Description="新建一条连接，填入模型名与接口地址即可开始。" />

          <ItemsControl ItemsSource="{Binding Connections}" IsVisible="{Binding HasConnections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="settings:ConnectionRowViewModel">
                <Border Classes="session-card" Margin="0,0,0,8">
                  <Button Classes="card-open" Command="{Binding OpenCommand}" CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                               Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding HasKey}" />
                      <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                               Fill="{DynamicResource TextDimBrush}" IsVisible="{Binding NoKey}" />
                      <StackPanel Grid.Column="1" Margin="10,0,10,0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                                   Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Classes="state-pill"><TextBlock Text="{Binding KeyLabel}" FontSize="10" /></Border>
                        <Border Classes="state-pill" ToolTip.Tip="{Binding WindowLabel}"
                                IsVisible="{Binding UsesModel}">
                          <TextBlock Text="{Binding UsedByLabel}" FontSize="10" />
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ContentControl Content="{Binding Editing}" IsVisible="{Binding IsEditing}" />
        </StackPanel>
      </c:Section.Body>
    </c:Section>

    <c:Disclosure Header="选项与续写" IsExpanded="False">
      <c:Disclosure.Body>
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding PreferenceSummary}" FontSize="{DynamicResource FsXs}"
                     Foreground="{DynamicResource TextDimBrush}" />
          <c:Switch IsChecked="{Binding OptionModeFillEdit}">
            <c:Switch.Body><TextBlock Text="选项『填入编辑』模式" FontSize="{DynamicResource FsSm}" /></c:Switch.Body>
          </c:Switch>
          <c:Switch IsChecked="{Binding AutoContinue}">
            <c:Switch.Body><TextBlock Text="截断自动续写" FontSize="{DynamicResource FsSm}" /></c:Switch.Body>
          </c:Switch>
          <c:Field Label="剧情选项频率">
            <c:Field.Body>
              <ComboBox ItemsSource="{Binding Frequencies}" SelectedItem="{Binding SelectedFrequency}"
                        HorizontalAlignment="Stretch" />
            </c:Field.Body>
          </c:Field>
        </StackPanel>
      </c:Disclosure.Body>
    </c:Disclosure>

  </StackPanel>
</UserControl>
