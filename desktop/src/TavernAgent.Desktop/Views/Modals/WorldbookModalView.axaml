<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TavernAgent.Desktop.ViewModels.Modals"
             xmlns:c="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Views.Modals.WorldbookModalView"
             x:DataType="vm:WorldbookModalViewModel">
  <c:Modal IsOpen="{Binding IsOpen}" CloseCommand="{Binding CloseCommand}" Title="世界书示例" DialogWidth="720">
    <c:Modal.Body>
      <StackPanel MaxWidth="660" HorizontalAlignment="Stretch" Spacing="12">
        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FsXs}"
                   Foreground="{DynamicResource TextDimBrush}"
                   Text="这里是内置的示例词条，用于说明世界书的结构；它们不是当前会话的设置。当前会话的世界书请在左栏「世界书」页签中检索与查看。" />
        <TextBox Text="{Binding Search}" PlaceholderText="检索示例词条…" />
        <c:EmptyState IsVisible="{Binding IsEmpty}" IconGeometry="{StaticResource IconBook}" Title="没有匹配的示例词条"
                      Description="当前版本未内置示例词条；请到左栏「世界书」页签查看本会话的词条与秘密。" />
        <ItemsControl ItemsSource="{Binding Entries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LoreExample">
              <Border Classes="surface-inset" CornerRadius="{DynamicResource RadiusMd}" Padding="12" Margin="0,0,0,8">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FsSm}" FontWeight="SemiBold" />
                  <Border Classes="state-pill" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Keys, StringFormat=触发词：{0}}" FontSize="10" />
                  </Border>
                  <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="{DynamicResource FsSm}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </c:Modal.Body>
  </c:Modal>
</UserControl>
