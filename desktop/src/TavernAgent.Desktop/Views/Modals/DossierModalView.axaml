<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TavernAgent.Desktop.ViewModels.Modals"
             xmlns:c="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Views.Modals.DossierModalView"
             x:DataType="vm:DossierModalViewModel">
  <c:Modal IsOpen="{Binding IsOpen}" CloseCommand="{Binding CloseCommand}" Title="档案与世界观" DialogWidth="980">
    <c:Modal.Body>
      <Grid ColumnDefinitions="200,*" ColumnSpacing="16" Height="480">
        <StackPanel Grid.Column="0" Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="34" Height="34" CornerRadius="{DynamicResource RadiusMd}"
                    Background="{DynamicResource AccentBrush}">
              <TextBlock Text="{Binding Character.Monogram}" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource AccentContrastBrush}" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Character.ShortName}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Character.Role}" FontSize="{DynamicResource FsXs}"
                         Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis" MaxWidth="130" />
            </StackPanel>
          </StackPanel>

          <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:DossierTab">
                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FsSm}" Padding="4,6" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>

        <Border Grid.Column="1" Classes="glass-subtle" CornerRadius="{DynamicResource RadiusMd}" Padding="14">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock Text="{Binding SelectedTab.Content}" TextWrapping="Wrap" Classes="narrative"
                                 FontSize="{DynamicResource FsSm}" />
          </ScrollViewer>
        </Border>
      </Grid>
    </c:Modal.Body>
  </c:Modal>
</UserControl>
