<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TavernAgent.Desktop.ViewModels.Modals"
             xmlns:c="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Views.Modals.MemoryModalView"
             x:DataType="vm:MemoryModalViewModel">
  <c:Modal IsOpen="{Binding IsOpen}" CloseCommand="{Binding CloseCommand}" Title="认知记忆库"
           DialogWidth="900" DialogHeight="640" HasInnerScroll="True">
    <c:Modal.Body>
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <WrapPanel Grid.Column="0" Orientation="Horizontal">
            <Button Classes="ui-btn sm quiet" Classes.active="{Binding IsAll}" Command="{Binding SetAllCommand}" Content="全部" Margin="0,0,8,4" />
            <Button Classes="ui-btn sm quiet" Classes.active="{Binding IsObserved}" Command="{Binding SetObservedCommand}" Content="亲历" Margin="0,0,8,4" />
            <Button Classes="ui-btn sm quiet" Classes.active="{Binding IsInferred}" Command="{Binding SetInferredCommand}" Content="推测" Margin="0,0,8,4" />
            <Button Classes="ui-btn sm quiet" Classes.active="{Binding IsSecret}" Command="{Binding SetSecretCommand}" Content="秘密" Margin="0,0,8,4" />
          </WrapPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding UsageText}" VerticalAlignment="Center" FontSize="{DynamicResource FsXs}"
                       Foreground="{DynamicResource TextDimBrush}" />
            <Button Classes="ui-btn sm quiet" Command="{Binding OrganizeCommand}" Content="整理记忆" />
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding Search}" PlaceholderText="检索记忆内容…" />
          <Button Grid.Column="1" Classes="ui-btn sm quiet" Margin="8,0,0,0" Command="{Binding SearchNowCommand}" Content="检索" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <c:EmptyState IsVisible="{Binding IsEmpty}" IconGeometry="{StaticResource IconBrain}" Title="暂无记忆条目"
                          Description="推进剧情后，见证、推测与秘密会在此沉淀并可修订。" />
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:MemoryRowViewModel">
                  <Border Classes="surface-inset" CornerRadius="{DynamicResource RadiusMd}" Padding="12" Margin="0,0,0,8">
                    <StackPanel Spacing="6">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="state-pill"><TextBlock Text="{Binding KindLabel}" FontSize="10" /></Border>
                        <TextBlock Text="{Binding ConfidenceText}" FontSize="10" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDimBrush}" />
                        <TextBlock Text="{Binding CreatedTurn, StringFormat=回合 {0}}" FontSize="10" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDimBrush}"
                                   IsVisible="{Binding CreatedTurn, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </StackPanel>
                      <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="{DynamicResource FsSm}" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="ui-btn sm ghost" Command="{Binding TogglePinCommand}" Content="{Binding PinLabel}" />
                        <Button Classes="ui-btn sm ghost" Command="{Binding ToggleHideCommand}" Content="{Binding HideLabel}" />
                        <Button Classes="ui-btn sm ghost" Command="{Binding ToggleExpandCommand}"
                                IsVisible="{Binding HasEvidence}">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="证据" VerticalAlignment="Center" />
                            <Path Classes="icon" Data="{StaticResource IconChevronDown}" Width="11" Height="11" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                      <Border IsVisible="{Binding IsExpanded}" Classes="surface-inset" Padding="10"
                              CornerRadius="{DynamicResource RadiusSm}">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding SourceQuote, StringFormat=引文：{0}}" TextWrapping="Wrap"
                                     FontSize="{DynamicResource FsXs}" Foreground="{DynamicResource TextSecondaryBrush}" />
                          <TextBlock Text="{Binding Reasoning, StringFormat=推理：{0}}" TextWrapping="Wrap"
                                     FontSize="{DynamicResource FsXs}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button Classes="ui-btn sm quiet" Command="{Binding PrevPageCommand}" IsEnabled="{Binding HasPrev}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Path Classes="icon" Data="{StaticResource IconChevronLeft}" Width="12" Height="12" />
              <TextBlock Text="上一页" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <TextBlock Text="{Binding Total, StringFormat=共 {0} 条}" VerticalAlignment="Center"
                     FontSize="{DynamicResource FsXs}" Foreground="{DynamicResource TextDimBrush}" />
          <Button Classes="ui-btn sm quiet" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNext}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="下一页" VerticalAlignment="Center" />
              <Path Classes="icon" Data="{StaticResource IconChevronRight}" Width="12" Height="12" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </c:Modal.Body>
  </c:Modal>
</UserControl>
