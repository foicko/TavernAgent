<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TavernAgent.Desktop.ViewModels.Modals"
             xmlns:c="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Views.Modals.PromisesModalView"
             x:DataType="vm:PromisesModalViewModel">
  <c:Modal IsOpen="{Binding IsOpen}" CloseCommand="{Binding CloseCommand}" Title="契约与承诺" DialogWidth="720">
    <c:Modal.Body>
      <StackPanel Spacing="12" Height="420">
        <TextBlock Text="{Binding CharacterName, StringFormat=与「{0}」之间的誓约与承诺}"
                   FontSize="{DynamicResource FsSm}" Foreground="{DynamicResource TextSecondaryBrush}" />

        <c:EmptyState IsVisible="{Binding IsEmpty}" Icon="🤝" Title="尚无契约或承诺"
                      Description="在剧情中主动立约或达成羁绊后，会在此跟踪履约状态。" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Promises}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:PromiseRowViewModel">
                <Border Classes="glass-subtle" CornerRadius="{DynamicResource RadiusMd}" Padding="12" Margin="0,0,0,8">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Classes="state-pill">
                        <TextBlock Text="{Binding StateLabel}" FontSize="10" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="{DynamicResource FsSm}" />
                    <TextBlock Text="{Binding SourceNodeId, StringFormat=来源节点 {0}}" FontSize="10"
                               Foreground="{DynamicResource TextDimBrush}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </c:Modal.Body>
  </c:Modal>
</UserControl>
