<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TavernAgent.Desktop.ViewModels.Left"
             xmlns:dto="using:TavernAgent.Core.Dtos"
             xmlns:c="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Views.Left.LorePanel"
             x:DataType="vm:LorePanelViewModel">
  <StackPanel Spacing="12">
    <TextBox Text="{Binding Query}" PlaceholderText="检索世界书设定（支持触发词）…" />

    <TextBlock Text="此会话暂无可检索的世界书词条。" IsVisible="{Binding !HasSession}"
               FontSize="{DynamicResource FsXs}" TextWrapping="Wrap"
               Foreground="{DynamicResource TextDimBrush}" />

    <TextBlock Text="检索中…" IsVisible="{Binding IsLoading}" FontSize="{DynamicResource FsXs}"
               Foreground="{DynamicResource TextDimBrush}" />
    <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               TextWrapping="Wrap" FontSize="{DynamicResource FsXs}" Foreground="{DynamicResource DangerBrush}" />

    <c:EmptyState IsVisible="{Binding IsEmpty}" Icon="📖" Title="没有匹配的世界书词条"
                  Description="尝试更换触发词，或推进剧情以揭示更多设定。" />

    <ItemsControl ItemsSource="{Binding Entries}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="dto:LorebookMatch">
          <Border Classes="glass-subtle" Padding="10" CornerRadius="{DynamicResource RadiusMd}" Margin="0,0,0,8">
            <StackPanel Spacing="5">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding Entry.Title}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                <Border Classes="state-pill">
                  <TextBlock Text="{Binding Entry.Enabled, StringFormat=按词触发}" FontSize="10" IsVisible="{Binding Entry.Enabled}" />
                </Border>
                <Border Classes="state-pill"><TextBlock Text="已禁用" FontSize="10" IsVisible="{Binding !Entry.Enabled}" /></Border>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Entry.Keys}" IsVisible="{Binding Entry.Keys.Count}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border Classes="chip" Margin="0,0,4,4"><TextBlock Text="{Binding}" FontSize="10" /></Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding Entry.Content}" TextWrapping="Wrap" MaxLines="3"
                         TextTrimming="CharacterEllipsis" FontSize="{DynamicResource FsXs}"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Button Classes="ui-btn sm quiet" HorizontalAlignment="Center" IsVisible="{Binding HasMore}"
            Command="{Binding LoadMoreCommand}" Content="加载更多词条" />

    <StackPanel Spacing="8" IsVisible="{Binding HasSecrets}">
      <TextBlock Text="秘密线索" FontSize="{DynamicResource FsSm}" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding Secrets}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="dto:SecretView">
            <Border Classes="glass-subtle" Padding="10" CornerRadius="{DynamicResource RadiusMd}" Margin="0,0,0,6">
              <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" />
                  <Border Classes="state-pill"><TextBlock Text="已揭示" FontSize="10" IsVisible="{Binding Revealed}" /></Border>
                  <Border Classes="state-pill"><TextBlock Text="未揭示" FontSize="10" IsVisible="{Binding !Revealed}" /></Border>
                </StackPanel>
                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="{DynamicResource FsXs}"
                           Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding Revealed}" />
                <TextBlock Text="推进剧情并达成条件后可查看。" FontSize="{DynamicResource FsXs}"
                           Foreground="{DynamicResource TextDimBrush}" IsVisible="{Binding !Revealed}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
