<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TavernAgent.Desktop.ViewModels.Left"
             xmlns:left="using:TavernAgent.Desktop.Views.Left"
             x:Class="TavernAgent.Desktop.Views.Left.LeftRailView"
             x:DataType="vm:LeftRailViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Classes="anim-slide-in-left">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,14,10,10">
      <TextBlock Grid.Column="0" Text="{Binding PanelTitle}"
                 FontSize="{DynamicResource FsLg}" FontWeight="SemiBold"
                 VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
      <Button Grid.Column="1" Classes="icon soft-brush" Content="✕"
              Command="{Binding CollapseCommand}" ToolTip.Tip="收起面板" />
    </Grid>

    <Border Grid.Row="1" Classes="divider" />

    <Grid Grid.Row="2" RowDefinitions="Auto,*">
      <!-- Tabs -->
      <Border Grid.Row="0" Padding="10,8">
        <Grid ColumnDefinitions="*,*,*,*">
          <Button Grid.Column="0" Classes="subtab" Classes.active="{Binding IsTreeTab}"
                  Command="{Binding ShowTreeCommand}" Content="因果" />
          <Button Grid.Column="1" Classes="subtab" Classes.active="{Binding IsCharactersTab}"
                  Command="{Binding ShowCharactersCommand}" Content="角色" />
          <Button Grid.Column="2" Classes="subtab" Classes.active="{Binding IsLoreTab}"
                  Command="{Binding ShowLoreCommand}" Content="世界书" />
          <Button Grid.Column="3" Classes="subtab" Classes.active="{Binding IsSessionsTab}"
                  Command="{Binding ShowSessionsCommand}" Content="会话" />
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16,4,16,20">
          <ContentControl IsVisible="{Binding IsTreeTab}">
            <left:BranchTreePanel DataContext="{Binding Tree}" />
          </ContentControl>
          <ContentControl IsVisible="{Binding IsCharactersTab}">
            <left:CharactersPanel DataContext="{Binding Characters}" />
          </ContentControl>
          <ContentControl IsVisible="{Binding IsLoreTab}">
            <left:LorePanel DataContext="{Binding Lore}" />
          </ContentControl>
          <ContentControl IsVisible="{Binding IsSessionsTab}">
            <left:SessionsPanel DataContext="{Binding Sessions}" />
          </ContentControl>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
