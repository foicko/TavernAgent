<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TavernAgent.Desktop.ViewModels.Left"
             x:Class="TavernAgent.Desktop.Views.Left.IconRailView"
             x:DataType="vm:LeftRailViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="0,12,0,12">

    <!-- Primary nav -->
    <StackPanel Grid.Row="0" Spacing="6" HorizontalAlignment="Center">
      <Button Classes="rail-btn" Classes.active="{Binding IsTreeTabActive}"
              Classes.visited="{Binding IsTreeTabVisited}"
              Command="{Binding ShowTreeCommand}" ToolTip.Tip="因果分支">
        <Path Classes="icon" Data="{StaticResource IconLeaf}" />
      </Button>
      <Button Classes="rail-btn" Classes.active="{Binding IsCharactersTabActive}"
              Classes.visited="{Binding IsCharactersTabVisited}"
              Command="{Binding ShowCharactersCommand}" ToolTip.Tip="角色卡库">
        <Path Classes="icon" Data="{StaticResource IconUser}" />
      </Button>
      <Button Classes="rail-btn" Classes.active="{Binding IsLoreTabActive}"
              Classes.visited="{Binding IsLoreTabVisited}"
              Command="{Binding ShowLoreCommand}" ToolTip.Tip="世界书">
        <Path Classes="icon" Data="{StaticResource IconBook}" />
      </Button>
      <Button Classes="rail-btn" Classes.active="{Binding IsSessionsTabActive}"
              Classes.visited="{Binding IsSessionsTabVisited}"
              Command="{Binding ShowSessionsCommand}" ToolTip.Tip="历史会话">
        <Path Classes="icon" Data="{StaticResource IconClock}" />
      </Button>
    </StackPanel>

    <!-- Center: director -->
    <StackPanel Grid.Row="1" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border Width="20" Classes="divider" />
      <Button Classes="rail-btn" Classes.active="{Binding IsDirectorActive}"
              Command="{Binding OpenDirectorCommand}" ToolTip.Tip="导演模式">
        <Path Classes="icon" Data="{StaticResource IconFilm}" />
      </Button>
    </StackPanel>

    <!-- Bottom: palette / theme / settings -->
    <StackPanel Grid.Row="2" Spacing="6" HorizontalAlignment="Center">
      <Button Classes="rail-btn" Command="{Binding OpenPaletteCommand}" ToolTip.Tip="命令面板 (Ctrl+K)">
        <Path Classes="icon" Data="{StaticResource IconSearch}" />
      </Button>
      <Button Classes="rail-btn" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="切换主题">
        <Path Classes="icon" Data="{StaticResource IconSun}" />
      </Button>
      <Button Classes="rail-btn" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="设置">
        <Path Classes="icon" Data="{StaticResource IconSliders}" />
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
