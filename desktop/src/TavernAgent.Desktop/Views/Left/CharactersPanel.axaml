<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TavernAgent.Desktop.ViewModels.Left"
             xmlns:c="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Views.Left.CharactersPanel"
             x:DataType="vm:CharactersPanelViewModel">
  <StackPanel Spacing="12">
    <Button Classes="ui-btn primary sm" HorizontalAlignment="Stretch" Height="32"
            Command="{Binding ImportCommand}">
      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
        <Path Classes="icon" Data="{StaticResource IconPlus}" Width="12" Height="12" />
        <TextBlock Text="导入 / 创建角色卡" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </Button>

    <Grid ColumnDefinitions="*,Auto" Margin="2,4,2,2">
      <TextBlock Grid.Column="0" Text="{Binding Cards.Count, StringFormat=已收录角色卡 ({0})}"
                 FontSize="{DynamicResource FsSm}" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="ui-btn sm ghost" Command="{Binding RefreshCommand}" Padding="6,2" ToolTip.Tip="刷新角色卡">
        <Path Classes="icon" Data="{StaticResource IconRefresh}" Width="12" Height="12" />
      </Button>
    </Grid>

    <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               TextWrapping="Wrap" FontSize="{DynamicResource FsXs}" Foreground="{DynamicResource DangerBrush}" />

    <c:EmptyState IsVisible="{Binding IsEmpty}" IconGeometry="{StaticResource IconMask}" Title="暂无角色卡"
                  Description="点击上方「+ 导入 / 创建角色卡」开始。" />

    <ItemsControl ItemsSource="{Binding Cards}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:CardRowViewModel">
          <Border Classes="char-card" Classes.active="{Binding IsActive}"
                  Classes.confirming="{Binding IsConfirmingDelete}" Margin="0,0,0,8">
            <Panel>
              <!-- Normal row -->
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsConfirmingDelete}">
                <Button Grid.Column="0" Classes="card-open" Command="{Binding OpenCommand}">
                  <Grid ColumnDefinitions="Auto,*">
                    <Panel Grid.Column="0" Width="40" Height="40">
                      <Border CornerRadius="{DynamicResource RadiusMd}" Background="{DynamicResource SubtleBrush}">
                        <TextBlock Text="{Binding Monogram}" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding !HasAvatar}" />
                      </Border>
                      <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}" />
                    </Panel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Classes="state-pill"><TextBlock Text="{Binding Badge}" FontSize="10" /></Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Desc}" FontSize="{DynamicResource FsXs}" TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                  </Grid>
                </Button>

                <Button Grid.Column="1" Classes="ui-btn sm ghost" Padding="4,0" ToolTip.Tip="移除角色卡"
                        Command="{Binding RequestDeleteCommand}" VerticalAlignment="Center">
                  <Path Classes="icon danger" Data="{StaticResource IconTrash}" Width="13" Height="13" />
                </Button>
              </Grid>

              <!-- Confirming row: clean full-width prompt -->
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding IsConfirmingDelete}">
                <TextBlock Grid.Column="0" Text="确认移除此角色卡？" FontSize="{DynamicResource FsXs}"
                           Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Classes="ui-btn sm danger" Padding="8,0" Height="26" MinWidth="0"
                        Content="移除" Command="{Binding ConfirmDeleteCommand}" />
                <Button Grid.Column="2" Classes="ui-btn sm quiet" Padding="8,0" Height="26" MinWidth="0"
                        Content="取消" Command="{Binding CancelDeleteCommand}" />
              </Grid>
            </Panel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
