<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TavernAgent.Desktop.ViewModels.Left"
             xmlns:c="using:TavernAgent.Desktop.Controls"
             xmlns:dto="using:TavernAgent.Core.Dtos"
             x:Class="TavernAgent.Desktop.Views.Left.StoryMapModal"
             x:DataType="vm:StoryMapViewModel">
  <c:Modal IsOpen="{Binding IsOpen}" CloseCommand="{Binding CloseCommand}" Title="剧情分支图" DialogWidth="920">
    <c:Modal.Body>
    <Grid ColumnDefinitions="*,260" ColumnSpacing="12" Height="520">

      <!-- Graph canvas -->
      <Grid Grid.Column="0" RowDefinitions="Auto,*">
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
          <ComboBox Name="BranchSelect" ItemsSource="{Binding Branches}" MinWidth="180" Margin="0,0,8,6"
                    SelectionChanged="OnBranchSelected" PlaceholderText="定位分支">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="dto:BranchView">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Classes="ui-btn sm quiet" Command="{Binding GoHeadCommand}" Content="当前分支头" Margin="0,0,8,6" />
          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="{DynamicResource FsXs}"
                     Foreground="{DynamicResource TextDimBrush}" Margin="0,0,8,6" />
          <Button Classes="ui-btn sm quiet" IsVisible="{Binding Truncated}" Content="仅展示附近节点" IsEnabled="False" Margin="0,0,8,6" />
        </WrapPanel>

        <TextBlock Grid.Row="0" Text="{Binding Error}" HorizontalAlignment="Right" VerticalAlignment="Center"
                   FontSize="{DynamicResource FsXs}" Foreground="{DynamicResource DangerBrush}"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <Border Grid.Row="1" Classes="surface-inset" CornerRadius="{DynamicResource RadiusMd}" ClipToBounds="True">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Background="Transparent">
              <ItemsControl ItemsSource="{Binding Links}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:StoryMapLinkViewModel">
                    <Path Data="{Binding Path}" Stroke="{DynamicResource BorderMidBrush}" StrokeThickness="1.5" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding Nodes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:StoryMapNodeViewModel">
                    <Button Classes="map-node" Classes.selected="{Binding IsSelected}"
                            Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"
                            Command="{Binding $parent[ItemsControl].((vm:StoryMapViewModel)DataContext).SelectNodeCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Spacing="2" Width="140">
                        <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="9.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextDimBrush}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Canvas>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- Detail rail -->
      <Border Grid.Column="1" Classes="surface-inset" CornerRadius="{DynamicResource RadiusMd}" Padding="12">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="{Binding DetailLabel}" FontWeight="SemiBold" FontSize="{DynamicResource FsMd}" />
            <TextBlock Text="{Binding DetailBranchName, StringFormat=分支 · {0}}"
                       IsVisible="{Binding DetailBranchName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       FontSize="{DynamicResource FsXs}" Foreground="{DynamicResource TextDimBrush}" />
          </StackPanel>

          <TextBlock Grid.Row="1" Text="{Binding DetailError}" TextWrapping="Wrap"
                     FontSize="{DynamicResource FsXs}" Foreground="{DynamicResource DangerBrush}"
                     IsVisible="{Binding DetailError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <ScrollViewer Grid.Row="2" Margin="0,8" VerticalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding DetailExcerpt}" TextWrapping="Wrap" Classes="narrative" FontSize="{DynamicResource FsSm}" />
          </ScrollViewer>

          <StackPanel Grid.Row="3" Spacing="6">
            <Button Classes="ui-btn sm quiet" HorizontalAlignment="Stretch"
                    Command="{Binding ExpandNearbyCommand}" Content="展开此节点附近" />
            <Button Classes="ui-btn sm primary" HorizontalAlignment="Stretch"
                    Command="{Binding ViewSnapshotCommand}" IsEnabled="{Binding !Busy}" Content="查看历史快照" />
            <Button Classes="ui-btn sm quiet" HorizontalAlignment="Stretch"
                    Command="{Binding ForkCommand}" IsEnabled="{Binding !Busy}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Classes="icon" Data="{StaticResource IconLeaf}" Width="12" Height="12" />
                <TextBlock Text="从此处开辟分支" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="ui-btn sm quiet" HorizontalAlignment="Stretch"
                    Command="{Binding SwitchBranchCommand}" IsEnabled="{Binding !Busy}"
                    IsVisible="{Binding SelectedBranch, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Content="切换到此分支" />
            <Button Classes="ui-btn sm quiet" HorizontalAlignment="Stretch"
                    Command="{Binding RegenerateCommand}" IsEnabled="{Binding !Busy}"
                    IsVisible="{Binding DetailIsTurn}" Content="重新生成此回合" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    </c:Modal.Body>
  </c:Modal>
</UserControl>
