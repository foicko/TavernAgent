<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TavernAgent.Desktop.ViewModels.Left"
             xmlns:c="using:TavernAgent.Desktop.Controls"
             x:Class="TavernAgent.Desktop.Views.Left.SessionsPanel"
             x:DataType="vm:SessionsPanelViewModel">
  <StackPanel Spacing="12">

    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="历史故事会话" FontSize="{DynamicResource FsXs}" FontWeight="Medium"
                 Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding TotalCount}" FontSize="{DynamicResource Fs2xs}"
                 Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
    </Grid>

    <Border Classes="surface-inset" CornerRadius="999" Padding="2" HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="*,*">
        <Button Grid.Column="0" Classes="seg" Classes.active="{Binding IsAllFilter}"
                HorizontalAlignment="Stretch" Command="{Binding SetAllFilterCommand}">
          <TextBlock Text="{Binding TotalCount, StringFormat=全部 ({0})}" FontSize="10.5"
                     TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>
        <Button Grid.Column="1" Classes="seg" Classes.active="{Binding IsCurrentFilter}"
                HorizontalAlignment="Stretch" Command="{Binding SetCurrentFilterCommand}"
                ToolTip.Tip="{Binding FilterCurrentLabel}">
          <TextBlock Text="{Binding FilterCurrentLabel}" FontSize="10.5"
                     TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>
      </Grid>
    </Border>

    <c:EmptyState IsVisible="{Binding IsEmpty}" IconGeometry="{StaticResource IconScroll}" Title="暂无历史故事会话"
                  Description="点击下方按钮开辟，或直接在底部输入框发言开启全新故事。" />

    <ItemsControl ItemsSource="{Binding Rows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:SessionRowViewModel">
          <Border Classes="session-card" Classes.active="{Binding IsActive}"
                  Classes.confirming="{Binding IsConfirmingDelete}" Margin="0,0,0,8">
            <Panel>
              <!-- Normal row -->
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsConfirmingDelete}">
                <Button Grid.Column="0" Classes="card-open" Command="{Binding OpenCommand}">
                  <Grid ColumnDefinitions="Auto,*">
                    <Panel Grid.Column="0" Width="32" Height="32">
                      <Border CornerRadius="{DynamicResource RadiusMd}" Background="{DynamicResource SubtleBrush}">
                        <TextBlock Text="{Binding Monogram}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding !HasAvatar}" FontSize="{DynamicResource FsXs}" />
                      </Border>
                      <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}" />
                    </Panel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FsSm}" FontWeight="Medium"
                                 TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding TimeText}" FontSize="10"
                                   Foreground="{DynamicResource TextDimBrush}" />
                        <Border Classes="state-pill" Classes.active="{Binding IsActive}">
                          <TextBlock Text="{Binding StatusText}" FontSize="10" />
                        </Border>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Button>

                <Button Grid.Column="1" Classes="icon-btn-compact" ToolTip.Tip="删除会话"
                        Command="{Binding RequestDeleteCommand}" VerticalAlignment="Center">
                  <Path Classes="icon xs" Data="{StaticResource IconTrash}" />
                </Button>
              </Grid>

              <!-- Confirming row: clean full-width prompt -->
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding IsConfirmingDelete}">
                <TextBlock Grid.Column="0" Text="确认删除此会话？" FontSize="{DynamicResource FsXs}"
                           Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Classes="ui-btn sm danger" Padding="8,0" Height="24" MinWidth="0"
                        Content="删除" Command="{Binding ConfirmDeleteCommand}" />
                <Button Grid.Column="2" Classes="ui-btn sm quiet" Padding="8,0" Height="24" MinWidth="0"
                        Content="取消" Command="{Binding CancelDeleteCommand}" />
              </Grid>
            </Panel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Action shelf -->
    <Button Classes="ui-btn primary sm" HorizontalAlignment="Stretch" Height="26"
            Command="{Binding NewStoryCommand}" ToolTip.Tip="{Binding NewStoryTooltip}">
      <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
        <Path Classes="icon sm" Data="{StaticResource IconSparkles}" />
        <TextBlock Text="{Binding NewStoryLabel}" FontSize="{DynamicResource FsXs}" FontWeight="Medium"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </StackPanel>
    </Button>

    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
      <Button Grid.Column="0" Classes="ui-btn quiet sm" HorizontalAlignment="Stretch" Height="25"
              Click="OnExportClick" IsEnabled="{Binding HasCurrentView}">
        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
          <Path Classes="icon sm" Data="{StaticResource IconDownload}" />
          <TextBlock Text="导出剧本" FontSize="{DynamicResource FsXs}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="1" Classes="ui-btn quiet sm" HorizontalAlignment="Stretch" Height="25" Click="OnImportClick">
        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
          <Path Classes="icon sm" Data="{StaticResource IconUpload}" />
          <TextBlock Text="导入故事" FontSize="{DynamicResource FsXs}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
      <Button Grid.Column="0" Classes="ui-btn ghost sm" HorizontalAlignment="Stretch" Height="28" Command="{Binding GoCharactersCommand}">
        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
          <Path Classes="icon" Data="{StaticResource IconUsers}" Width="12" Height="12" />
          <TextBlock Text="角色库" FontSize="11.5" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="1" Classes="ui-btn ghost sm" HorizontalAlignment="Stretch" Height="28" Command="{Binding GoImportCommand}">
        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
          <Path Classes="icon" Data="{StaticResource IconPlus}" Width="12" Height="12" />
          <TextBlock Text="导入角色卡" FontSize="11.5" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>
  </StackPanel>
</UserControl>
