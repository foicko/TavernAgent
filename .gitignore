# 本地环境变量（含密钥）：绝不入库；模板用 .env.example
.env
.env.*
!.env.example

# 设计参考组件源码（第三方下载，无上游许可证文本，仅本地参考，不入库）
/reference-components/

# Local reference materials & assets (design mockups, papers, imported char cards)
/design-preview/
/papers/
/chars/
# 本地角色卡素材：个人 .charx 归档与导出的卡片 JSON，不入库
/card.json
/charx/
# 根目录的本地参考资料（学习用 PDF/规范文档，不入库）
/AI-Agents-in-Depth-zh-CN.pdf
/Agent开发规范.md

# Agent harness state (plan files written by the coding assistant, not project content)
/.zcode/
/.codebuddy/

# Local Runtime Data
/data/

# OS and Editor files
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
.trae/
.workbuddy/

# Build artifacts
/dist/
/disk/
/build/
# 前端构建产物：由 pnpm build 生成、被 //go:embed 嵌入。
# 不入库，避免"改了 src 忘了重建、go build 静默嵌入旧前端"。
web/dist/
bin/
obj/
*.exe
*.dll

# Local secrets (API keys live only on the backend host)
data/config/secrets.json

# Frontend
web/node_modules/
web/.vite/
archive/showcase/node_modules/
archive/showcase/.vite/
archive/showcase/dist/
node_modules/

# Local verification scratch (published reports live in docs/artifacts)
/.playwright-cli/
/output/
__pycache__/
*.pyc

# 架构图的位图渲染：由 scripts/architecture_diagram.py 生成，可随时重出；
# 入库版本是矢量版 docs/artifacts/architecture/*.svg。
# 发布审计对仓库里的任何位图一律判违规（scripts/release_audit.py），
# 且本项目"仓库里只放矢量"的约定由此保持。
docs/artifacts/architecture/*.png

# 本地运行库 scaffold（脚本生成的 data.<用途>-<时间戳>/ 快照，含 storage.db，不入库）
/data.*/

